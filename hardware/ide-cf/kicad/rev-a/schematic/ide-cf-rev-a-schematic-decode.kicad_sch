	(text "BUS, I/O DECODE AND THE STROBE WINDOW" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "b3e87511-edf2-5c00-a5bc-e1f920a526c7"))
	(text "U$1: the System-5 bus (only D0-D7, -MRD, TPA, TPB, N0-N2 and -RESET are used). IC4 decodes N0-N2 into PORT1-7\n(Y0 = no I/O). -MRD tells OUT (low) from INP (high); the NAND latch IC2 makes the strobe window from TPA and TPB.\nSV1 picks the register-select port (IDESEL: port 2 on Ken's card), SV2 the data port (IDERW: port 3)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "8e12c5c0-8cb8-5817-a5c3-188f17b844bd"))
	(embedded_fonts no)
)
