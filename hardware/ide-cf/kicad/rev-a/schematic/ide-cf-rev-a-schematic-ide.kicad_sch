	(text "REGISTER LATCH, READ/WRITE STROBES AND THE 40-PIN IDE HEADER" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "a06d0f50-f3b5-57e8-805c-fc23945b2269"))
	(text "OUT to IDESEL opens the 74LS75 (IC7): D0-D2 = DA0-DA2, D3 = CS0 (0) or CS1 (1, the control block).\nIDERW with OUT = -DIOW, with INP = -DIOR (IC6, pulled up by R13/R14). D0-D7 go straight to the drive's DD0-DD7:\n8-bit mode only (the BIOS sends SET FEATURES 01). The bus -RESET resets the drive (pin 1)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "133d0c88-618c-5f11-a4ca-6a25ce793d64"))
	(embedded_fonts no)
)
