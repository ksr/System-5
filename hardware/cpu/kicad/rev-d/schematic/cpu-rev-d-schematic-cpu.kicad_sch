	(text "THE CDP1802 AND THE 36-PIN BUS" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "f7d806d2-5a43-5dcd-af5b-656ebf9b42c3"))
	(text "U1's signals go to the bus unbuffered (D0-D7, A0-A7, TPA, TPB, -MRD, -MRW, Q, N0-N2), as on Rev A.\nBus positions, counted from GND (1): 31-33 -EF1..-EF3, 34 -DMAIN, 35 SC0, 36 -PAUSE (the 36-pin extension)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "a339fa2a-d567-5529-b97b-c9892f04d949"))
	(embedded_fonts no)
