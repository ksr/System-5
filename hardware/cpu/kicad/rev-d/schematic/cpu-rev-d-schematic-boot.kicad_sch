	(hierarchical_label "WIN_L" (shape output) (at 193.04 81.28 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "43f1a24f-1323-5332-990b-95f87a32943f"))
	(text "A8-A15 LATCH, 2732 BOOT EPROM AT F000, BOOT MAP AND -VMA" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "e428f30e-1947-5932-b4c3-b79a7bbd39e1"))
	(text "U2 latches A8-A15 while TPA is high. After a reset the boot map puts the EPROM at every address (-VMA high) until\nthe first access with A15 high (U4B), unless LOADED is set. Then the EPROM answers only at F000-FFFF (U6A: WIN_L);\n-VMA = BOOTMAP + WIN (U5B), the EPROM's CE = ROM_SEL_L (U5C)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "c5d26104-8be9-515f-ab48-f7b43d53646f"))
	(embedded_fonts no)
)
