	(text "RESET, RUN, PAUSE, LOAD: DS1813, RESET/RUN SWITCH, CLEAR/WAIT/DMA-IN BUFFERS, LOADED" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "724d5e07-7c4f-5dc9-9fe4-0f94990d2a7f"))
	(text "CLEAR = -RESET, WAIT = -PAUSE, DMA_IN = -DMAIN, each through two Schmitt inverters: reset, run, pause (-PAUSE low)\nand load (both low) follow directly. U10 DS1813: power-on reset and switch debounce on the open-collector -RESET\n(no watchdog). SW1 RESET grounds SW_RST: -RESET through D1, and LOADED (U8A) cleared. LOAD mode sets LOADED." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "c1a8584c-2bd5-55e0-8fb1-73656b282eba"))
	(embedded_fonts no)
