	(text "EF ROUTING, INTERRUPT, Q LED" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "20b9ff41-7567-5bb2-aa43-26d56849c5c7"))
	(text "JP2-JP5: one block per EF input (EF1-EF4); its rows are the bus flag lines -EF1, -EF2, -EF3, -EF, and a jumper\nacross a row puts that line on the input (any input from any line). RN2 holds an unjumpered input high (off)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "6c4b70ba-d63d-5c13-a81e-0b4ba1d1649e"))
