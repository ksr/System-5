	(text "EF ROUTING (JP1-JP4), THE 1861 RIBBON, INTERRUPT, DMA, Q LED" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "dbb55de6-7b20-51ae-b05e-8b32a4230033"))
	(text "JP1 routes the bus -EF line, JP2 the front panel's flag (FEF), JP3 the 1861's (VEF), JP4 the keyboard's over the\nribbon (KEF) to one of EF1-EF4 (Ken's card: JP1 row 3, bus -EF -> EF3). SV3 carries SC0, SC1, DMA OUT, LCLK, KEF\nand VEF to the IO card. -INT, DMA IN and DMA OUT have pull-ups." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "2d4a1c79-e08e-5de8-8893-fb4222916b57"))
	(embedded_fonts no)
