	(text "RESET AND RUN CONTROL: CM1232, RUN ONE-SHOT, WAIT/CLEAR LATCHES, FRONT PANEL HEADER" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "d207cfcd-c64a-5d58-b2b6-ef9f7efee42d"))
	(text "U1 holds -RESET low after power-up and for the S1 / SV1 push-button. When it lets go, the 74LS123 (IC5) fires a pulse\non -RUN (open collector, IC6A). IC3 and IC4 (74LS20) are set/reset latches on WAIT and CLEAR, set and cleared by the\nopen-collector command lines -RESET, -RUN, -PAUSE, -LOAD (10k pull-ups); the front panel header SV6 shares them." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "27bdb1cd-9df0-5710-853c-b5b8e8f55b5d"))
