	(text "THE CDP1802 AND ITS CLOCK" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "de411ad9-cd7b-50b3-8d18-2e047bf6be0c"))
	(text "U$2: the System-5 bus; the 1802's signals go to it unbuffered. Q1 with three NANDs of IC7 is the oscillator; IC8A\ndivides it by 2 for the 1802's CLOCK, and its other output is LCLK for the 1861 (ribbon SV3)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "f4ca8a9f-3d0d-5c67-b686-b064f91fa4fe"))
	(embedded_fonts no)
