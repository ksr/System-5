	(hierarchical_label "~ROMWIN" (shape passive) (at 259.08 78.74 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0443373b-0b83-5099-831a-d8d1517e68a5"))
	(text "A8-A15 LATCH, BOOT EPROM, 4K WINDOW, BOOT FLIP-FLOP AND -VMA" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "107ab6c9-639f-5060-9de7-7cbc5ddeee92"))
	(text "IC1 latches A8-A15 on TPA (a 74LS374 on the built card). IC9 decodes A12-A14 into eight 4K banks, A15 enabling it\nthrough SV2 (H/L); SV4 picks the EPROM's bank (bank 7: F000). IC8B, cleared by -RESET, ends the boot map; SV5 picks\nBoot only / Boot+REMAP / No ROM. IC7D and IC6 (open collector) make -VMA and the EPROM's -CE (R13 pull-up)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "908d0be6-30bb-5a8d-9704-0b4981e24060"))
	(embedded_fonts no)
