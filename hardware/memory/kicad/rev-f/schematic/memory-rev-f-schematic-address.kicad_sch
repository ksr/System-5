	(hierarchical_label "~BUFFADDR15" (shape output) (at 158.75 170.18 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "2280ee17-f520-5088-a6db-dbe28e2ae7ab"))
	(text "BUS BUFFERS, THE A8-A15 LATCHES AND THE BANK SELECTS" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "bd8c493c-3371-5213-a044-d558871b6932"))
	(text "CD4050B buffers (IC7, IC8) put one CMOS input on A0-A7, -MRD and -MRW. The CD4042B latches (IC6, IC9; clock = TPA,\nPOL high) are transparent while TPA is high and hold when it falls: they capture A8-A15 from the buffered A0-A7.\nBank selects (IC14A, IC14B): ~LO_BANK = -VMA OR A15, ~HI_BANK = -VMA OR /A15: low for a valid address in that half." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "9c75a9a5-f47e-50ea-8eeb-f00fc1320ec0"))
	(embedded_fonts no)
)
