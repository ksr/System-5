	(text "EPROM 0000-7FFF (IC3): 74HCT151 BLOCK SELECT, JUMPERS, GATED !CE AND LED" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "539b7b81-64d5-54b7-a4aa-f8560b263772"))
	(text "SV3 is the ROM row of the LO field: a jumper from it to the GND row (SV2's even pins) gives the block to the EPROM.\nOne jumper per column, so a block is never both. !CE = Y OR ~LO_BANK (IC14D). LED4: IC3 enabled." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "006adf26-e2fe-57e9-978b-239c6e4eb40b"))
	(embedded_fonts no)
