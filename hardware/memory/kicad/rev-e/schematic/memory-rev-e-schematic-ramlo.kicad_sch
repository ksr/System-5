	(text "RAM 0000-7FFF (IC1): 74HCT151 BLOCK SELECT, JUMPERS, GATED !CE AND LED" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "c2a470d4-1693-51af-9cd2-e4239ac9cf34"))
	(text "SV2 is the LO jumper field: its odd pins are IC2's eight block inputs (0000 ... 7000), pulled high by RN1; its even\npins are GND. A jumper from GND to a RAM pin gives that 4K block to the RAM. A12-A14 pick the input; !CE = Y OR\n~LO_BANK (IC14C): low only for a valid address in a jumpered block. LED2 sinks into it: lit while IC1 is enabled." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "b1fb4a3b-7255-551d-bb96-7dd773b660f7"))
	(embedded_fonts no)
)
