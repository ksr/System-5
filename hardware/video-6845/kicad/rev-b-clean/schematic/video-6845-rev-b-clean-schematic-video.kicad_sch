	(text "CHARACTER LATCHES, CHARACTER GENERATOR, DOT SHIFTER, PIPELINE, REVERSE VIDEO, COMPOSITE OUT" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "3efdd2e3-06de-5e67-96e3-9e3d8cef81d8"))
	(text "IC10 / IC7 latch the character (bits 0-6) onto the 2732's A3-A9; VROWS are A0-A2: the font is 128 x 8 at 000-3FF\n(goodfont). IC11 shifts out the five dots. Bit 7 XOR CURSOR (IC13A) is reverse video; IC9 delays it and DE by two\ncharacters; IC13B XORs it into the dots; IC5D blanks outside DE. IC14 (7416) mixes video and syncs for the RCA jack\n(composite). Rev B's DB9, which carried the same video and the two syncs separately, is not on this board." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "8c19a001-5ac6-548e-a171-3208c48ee6c7"))
	(embedded_fonts no)
)
