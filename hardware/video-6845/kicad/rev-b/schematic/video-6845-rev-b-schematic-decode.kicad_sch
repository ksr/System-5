	(text "BUS DECODE: A8-A15 LATCH, 4K BLOCK COMPARE (SV1), RAM AND CRTC SELECTS" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "81b3b3d5-3b3b-53f0-9406-1666175b1d68"))
	(text "IC2 latches A8-A15 while TPA is high. IC4 compares A12-A15 with SV1 (1-2: block 7) and matches only while -VMA is low\n(IC6F): BLOCK. Within the block A11 picks the device: A11 = 0 enables the video RAM's bus port (~VRAM_CE),\nA11 = 1 the 6845 (~CRTC_CS). E = TPB, R/W = -MRW, RS = A0: 7800 address register, 7801 data, repeated." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "ce7a0156-1b6e-5613-ad2f-841bec3d14fc"))
	(embedded_fonts no)
)
