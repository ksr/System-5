	(text "THREE MCP23017 I/O EXPANDERS ON THE 36-PIN BUS" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "fa9d6a28-1333-57a2-9494-e54be346dd0d"))
	(text "U1 (0x20) and U2 (0x21) as on BUSDRV-B: D0-D7, A0-A7, TPA, TPB, -MRD, -MRW, -VMA, Q, -RESET, -INT, -EF, N0-N2.\nU3 (0x22): GPA0-5 = -EF1, -EF2, -EF3, -PAUSE, -DMAIN, SC0 (read only); GPB0-2 = the DEBUG cable's CLOCK, SC0, SC1.\nNo buffers: a pin is an input (monitor) or drives the line; the open-collector lines are only pulled low or let go.\nGPA7/GPB7 are output-only: SPARE1-4, SPARE10-11." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "33c0d41b-3494-53f0-9ea3-73093621f371"))
