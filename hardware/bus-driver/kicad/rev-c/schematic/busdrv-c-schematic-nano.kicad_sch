	(text "ARDUINO NANO: I2C, EXPANDER RESET, BUS SENSE, CLOCK OUT, PROBES, HEADERS" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "08800b46-1f09-5604-9de9-bd10d6b3e778"))
	(text "I2C on A4/A5 with 4.7k pull-ups to bus +5V (R1, R2). XRST (D4, R3) holds the expanders reset until the bus has\npower, sensed on A0 through R4/R5. D2, D3, D5 take the expanders' INTA. CLK OUT: Timer 1 (D9) through R7, on J2\nand on J4 DEBUG, cabled to CPU Rev D's J2 (EXT CLK, GND, CLOCK, SC0, SC1, GND). PROBE1 (D8, input capture) and\nPROBE2 (A1) through 1k. J2: CLK OUT, the probes, SPARE1-4, +5V, GND; J3: SPARE5-11, GND." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "afbb8411-d7f3-50f5-8d8e-0533047e5cfe"))
	(embedded_fonts no)
)
