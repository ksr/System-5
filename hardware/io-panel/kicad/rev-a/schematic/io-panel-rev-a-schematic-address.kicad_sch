	(text "THE BUS ADDRESS ON FOUR TIL311 HEX DISPLAYS" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "a4a9f343-99a7-5ea4-a680-3aacc783a050"))
	(text "The 1802 puts the high address byte on A0-A7 during TPA, then the low byte. U18 (74HCT573, LE = TPA) holds the high\nbyte as TPA falls, U19 (LE = TPB) the low byte as TPB falls; U14-U17 show A15-A0 (strobe low = transparent). The\ndisplay holds the last cycle's address while the clock is stopped; in LOAD mode it shows R0, where the next byte goes.\nThe latches keep the bus to HCT inputs (Ken, 2026-11-18)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "ec7dce3a-bac9-5414-bf5f-e811fe5122d0"))
	(embedded_fonts no)
)
