	(text "INPUT BUTTON, RUN AND LOAD, ONE DMA IN PER PRESS, Q LED" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "00682844-b0f4-5080-b394-69de1bae77e3"))
	(text "INPUT (SW9, R9/C1 + Schmitt) drives -EF1 (open collector, U9). SW10 RUN/RESET grounds -RESET, SW11 LOAD grounds\n-PAUSE: both = LOAD mode (LOAD_H). In LOAD mode a press sets REQ (U10A: -DMAIN); the write's -MWR rise sets ACK (U10B),\nwhich clears REQ until the button is let go. DRIVE (U11A) keeps the switches on the bus until -MRD falls." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "57fb7b16-ac09-5c04-a97f-46f13bf1f934"))
