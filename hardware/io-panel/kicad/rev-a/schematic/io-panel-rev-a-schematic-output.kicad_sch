	(text "OUT 4: LATCH, EIGHT LEDS, TWO TIL311 HEX DISPLAYS" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "15523e19-277e-59d7-9080-38dc1fa4424e"))
	(text "U2 latches the OUT 4 byte. The LEDs show it bit by bit (sourced through 1k), U7 shows bits 7-4 and U8 bits 3-0 in\nhex (TIL311 strobe low = transparent, blanking low = on). TIL311 pinout as on Ken's YACC1 IO card." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "27b4669f-d0bd-5fef-b665-1777e65c097a"))
