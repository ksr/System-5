	(text "DISPLAY LATCH, DOT SHIFTER, THE GFX-ON GATE" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "5ee68fe0-7293-50c9-813f-20e013fdab3d"))
	(text "IC8 latches the display-half byte at CHARCLOCK, IC9 shifts it out at the dot clock (bit 7 = leftmost), IC16D\npasses the dots only while GFX-ON: GDOT to TEXT, two characters behind like the text dots." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "d48366d0-6ded-58db-9785-3f9befb611a2"))
