	(text "PS/2 MOUSE (ATmega328P), MOUSE LATCH (READ AT 7806), MOUSE-READY" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "8ddd9b6a-eea9-5b17-ace2-4d582176cd30"))
	(text "The keyboard firmware in mouse mode (PD7 low through R6). It loads IC12 with LDDATA, which sets MOUSE-READY (IC13B);\na read of 7806 (-RDMOUSE) clears it at TPB (IC18A, IC16C). It reports only while MOUSE-ON. The bus -RESET resets it through IC15A/B." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "b5fee3e6-df72-585d-89f9-41ea832b95b1"))
	(embedded_fonts no)
)
