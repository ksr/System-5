	(text "THE TEXT / GRAPHICS COMBINE, THE SYNC BUFFERS, RCA AND DB9" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "56d21766-8004-5af9-8db3-8f29f3f556ff"))
	(text "dot = (text AND TEXT-ON) OR GDOT, or their XOR when XORM (from GFX); gated by DE3. The syncs are buffered (IC19C,\nIC18A) so the cable never loads the 6845. RCA: composite through R4 / R5. DB9: TTL video, HSYNC, VSYNC +/- by JP2." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "ec13dec7-c3e1-5d63-b903-4eb79b194e0d"))
	(embedded_fonts no)
