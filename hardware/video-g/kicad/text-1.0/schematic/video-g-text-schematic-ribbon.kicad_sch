	(text "Pin map: hardware/video-g/kicad/common/ribbon.py. The clocks leave through 33 ohm (R11-R13). With GFX absent RN2\nholds TEXT-ON high and RN3 holds GDOT, XORM, MOUSE-READY, GFX-PRESENT (and MONITOR, JP1 open) low." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "d27508b3-aa39-5dc5-b534-fd0948b017c8"))
