	(text "THE 6845 ON PORTS 5 / 6 AND THE IDT7134 TEXT RAM" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "cd248709-aaa7-5aed-8b3a-2f5127a4f60a"))
	(text "The IDT7134's right port is the bus (2K: A11R low), its left port the 6845's refresh address MA0-MA11: no snow.\n6845: -CS = port 5 or 6 (IC18C), RS = N1 (5 = address, 6 = data), R/-W = -MRD, E = NAND(-RD6, -WR5, -WR6) (IC21C):\nthe whole INP 6 from 2 T, or TPB in an OUT; it latches as E falls with R/-W still low." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "53898c13-73dc-5e8a-83d6-db4a5f8dab11"))
	(embedded_fonts no)
)
