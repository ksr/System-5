	(text "BUS: MEMORY DECODE (7000-7FFF), PORT DECODE, IOCYC" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "45026d75-a4c8-57a1-8313-e7dde1c04eab"))
	(text "IC1 latches A8-A15 while TPA is high; IC2 compares A12-A15 with the BLOCK jumper (1-2 only = block 7) while -VMA is\nlow -> BOARDSEL. A11 low: -TXTCE (the text RAM, 7000-77FF); A11 high: GSEL (the GFX window, 7800-7FFF).\nIC5 decodes N0-N2 always (Y0 = no port: IOCYC's D); IOCYC (IC24A) = N != 0 sampled as TPA falls. IC6: read enables\n(IOCYC and -MRD high = INP); IC7: write strobes (TPB and -MRD low = OUT). RN2 pulls up -EF, -VMA, -RESET." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "fb097120-2bce-50b8-963c-0669b4740755"))
	(embedded_fonts no)
