	(text "10K PULL-UPS: D0-D7 (RN1) AND THE OPEN-COLLECTOR LINES (RN2)" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "daaa33fd-7ef7-5759-9fb4-602b3078ba4b"))
	(text "RN1: an empty read gives FF. RN2: -EF, -EF1-3, -PAUSE, -DMAIN, -INT, -RESET (the CPU card also pulls up -INT and -RESET; these hold them with it out)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "5ae02416-41ce-5421-91f5-ae8a62a05826"))
