	(text "POWER IN, SWITCH, FUSE, REVERSE PROTECTION, BULK CAPACITOR, POWER LED" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "69dc236b-13b5-5436-a5d1-66a3742cc2e8"))
	(text "J9: +5V (pin 1) and GND (pin 2). SW1 power switch (ON = common to pin 3; pin 1 open), F1 4 A polyfuse. Q1 P-MOSFET,\ndrain to the supply, source to the cards, gate to GND (R2): on when the supply is right, off when it is reversed.\nC1 220 uF bulk; C2-C9 0.1 uF, one at each slot. No regulator." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "9dcc51e2-953c-5698-84bf-a5b9c5144e7c"))
