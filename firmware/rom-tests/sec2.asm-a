crtca:		equ	0c800h
crtcd:		equ	crtca+1
vmem:		equ	0c000h
JUMPTBL:	equ	0ff00h
basic_start:	equ	0f700h
basic_end:	equ	0feffh
basic_dest:	equ	00100h
line23:		equ    vmem+(80*23)
basmon:		equ	0f500h

		org 0f000h
boot:		ldi high boot	; Load D immediate
		phi r0		; Put high register R0
		ldi 01h
		phi r2
		ldi 00h
		plo r2
		sex r2
loop:		inp  4
		out 4
		dec r2
		ldx
		shr
		bdf on
		req
		br loop
on:		seq		
		br loop
