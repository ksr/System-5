    1 0000:              ;
    2 0000:              ; HBIOS v1.0.5 (2026-11-12): v1.0.4 plus the monitor commands H and B (at the end of this file). build.py
    3 0000:              ; assembles it with tools/asm1802.py and merges it with Mike Riley's BIOS, v1.0.4's orig_bios/bios.img.
    4 0000:              ;
    5 0000:              ; Define BIOS to generate code for use with ELFOS BIOS
    6 0000:              ;
    7 0000:              
    8 0000:              
    9 0000:              
   10 0000:              ;
   11 0000:              ; Define 6845VIDEOLOWER when video card (REV B and beyond) supports lower
   12 0000:              ; case characters and there is no need to force characters to upper case
   13 0000:              ;
   14 0000:              
   15 0000:              
   16 0000:              
   17 0000:              ;
   18 0000:              ; Define BASIC if the is for use with Tiny basic and not for ELFOS
   19 0000:              ;
   20 0000:              
   21 0000:              ;
   22 0000:              ; minimon is entry point in ELFOS  to jump to once bios has booted
   23 0000:              ;
   24 0000:              
   25 ff54:             minimon:	equ     0ff54h
   26 0000:              
   27 7800:             crtca:		equ	07800h		; CRTC Address register
   28 7801:             crtcd:		equ	crtca+1		; CRTC Data register
   29 000e:             cur_h:		equ     14		; Cursor postion high
   30 000f:             cur_l:		equ     15		; Cursor postion low
   31 0000:              
   32 7000:             vmem:		equ	07000h		; Start of video memory
   33 7800:             vmem_end:	equ     07800h		; End of video memory
   34 77fe:             vmem_ch:	equ	vmem_end-2
   35 77ff:             vmem_cl:	equ     vmem_end-1
   36 0020:             space:		equ	020h		; Ascii Space
   37 0000:              
   38 ff00:             JUMPTBL:	equ	0ff00h
   39 f700:             basic_start:	equ	0f700h
   40 feff:             basic_end:	equ	0feffh
   41 0100:             basic_dest:	equ	00100h
   42 0000:              ;expline23:		equ     vmem+(80*23)
   43 73c0:             line23:		equ     vmem+(64*15)
   44 f500:             basmon:		equ	0f500h
   45 0000:              
   46 f000:              		org 0f000h
   47 f000: f8 f0        boot:		ldi high boot	;Trigger Boot rom remap
   48 f002: b0           		phi r0		;
   49 f003: f8 78              		ldi high crtca  ; Register E set to CRTC Address register
   50 f005: be                 		phi re          ;
   51 f006: f8 00        	        ldi low crtca   ;
   52 f008: ae           	        plo re          ;
   53 f009: f8 78              		ldi high crtcd  ; Register F set to CRTC Data register
   54 f00b: bf           		phi rf          ;
   55 f00c: f8 01        	        ldi low crtcd   ;
   56 f00e: af                           plo rf          ;
   57 f00f: f8 f0        		ldi high vtable ; Register D set to vtable (CRTC parameters)
   58 f011: bd           		phi rd          ;
   59 f012: f8 42        		ldi low vtable  ;
   60 f014: ad           		plo rd          ;
   61 f015: f8 00        		ldi 00          ; Register C set to 0000
   62 f017: bc           		phi rc          ; Register C will be a counter used to point to the CRTC data register
   63 f018: ac           		plo rc          ;
   64 f019:              ;
   65 f019:              ; Load Video Paramters into CRTC
   66 f019:              ;
   67 f019: 8c           vload:          glo rc          ; Main loop, get counter register
   68 f01a: 5e           	        str re          ; Store into CRTC address register
   69 f01b: 4d           	        lda rd          ; Get video paramter
   70 f01c: 5f           	        str rf          ; Store into CRTC data register
   71 f01d: 1c                 		inc rc          ; Increment counter
   72 f01e: 8c           	        glo rc          ; Has counter reached 010h
   73 f01f: fb 10        	        xri 010h        ;
   74 f021: 3a 19        	        bnz  vload      ; If not load next CRTC Video paramter
   75 f023:              ;
   76 f023:              ; Clear Video memory (with space charachter)
   77 f023:              ;
   78 f023:              
   79 f023: f8 70        		ldi high vmem   ; Register F set to start of Video memory
   80 f025: bf           		phi rf          ;
   81 f026: f8 00        		ldi low vmem    ;
   82 f028: af           		plo rf          ;
   83 f029: f8 20        clear:          ldi space        ; Load D  space character
   84 f02b: 5f           		str rf          ; Sstore in Video memory
   85 f02c: 1f           		inc rf          ; Increment Register F to next video memory location
   86 f02d: 9f           		ghi rf          ; Check if past end of video memory
   87 f02e: fb 78        		xri high vmem_end ; Logical XOR D with value
   88 f030: 3a 29        		bnz clear       ; Short branch on D!=0
