  304 f100:              		org 0f100h
  305 f100: 3e 00        inchar:         bn3  inchar    ; Wait for an input character
  306 f102: e2                   	sex 2
  307 f103: 69           		inp 1          ; Read character
  308 f104: 22           		dec r2         ; Decrement (R2) Save inputed character across call
  309 f105: d4           		sep r4         ; Output the character
