  869 f7cd:              ;
  870 f7cd:              ; More of the monitor's commands, in the free bytes after the keyboard code: F200-F7FF is full.
  871 f11c:              		org 0f11ch
  872 f11c:              ;
  873 f11c:              ; Q1 / Q0: the 1802's Q output on (SEQ, 7B) or off (REQ, 7A). Any number but 0 turns it on.
  874 f11c: f8 00        monq:		ldi high 0004h	; read the number again from after the Q: f_hexin does not skip spaces
