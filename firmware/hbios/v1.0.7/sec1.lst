  340 f20c:              ;
  341 f20c:              ; Monitor commands added in HBIOS v1.0.5 (Ken, 2026-11-12): H lists the commands, B boots the OS from the CF card,
  342 f20c:              ; D start:end disassembles (a screenful at a time, waiting for a key; D start alone shows one screenful), Q1 / Q0
  343 f20c:              ; turn the 1802's Q output on / off. @F1C0 runs a small IO panel demo.
  344 f20c:              ; Mike Riley's monitor (F900) goes back to its prompt when it does not know a command. build.py patches that one
  345 f20c:              ; branch (F940: BNZ F913 becomes BNZ F9EB) and puts LBR monext in the 's free bytes at F9EB, so an unknown
  346 f20c:              ; command comes here. On entry: RC.1 = the command character, RA = the hex number typed after it, X = 2, P = 3,
  347 f20c:              ; SCRT set up (R4 call, R5 return). F913 is the monitor's prompt: it types test> and reads the next line.
  348 f20c:              ;
  349 f913:             monprompt:	equ 0f913h
  350 ff09:             f_msg:		equ 0ff09h	; type the zero-terminated text at RF
  351 ff15:             f_ltrim:	equ 0ff15h	; RF past spaces
  352 ff45:             f_hexin:	equ 0ff45h	; RD = the hex number at RF; RF after it
  353 ff48:             f_hexout2:	equ 0ff48h	; two hex digits of RD.0 to RF, RF after them
  354 ff4b:             f_hexout4:	equ 0ff4bh	; four hex digits of RD to RF, RF after them
  355 f20c: 9c           monext:		ghi rc		; the command character
  356 f20d: fa df        		ani 0dfh	; lower case to upper case (b -> B, h -> H)
  357 f20f: ff 42        		smi 'B'
  358 f211: c2 f2 26     		lbz monboot	; B: boot the OS
  359 f214: ff 02        		smi 'D'-'B'
  360 f216: c2 f3 ec     		lbz mondis	; D: disassemble
  361 f219: ff 04        		smi 'H'-'D'
  362 f21b: c2 f2 2e     		lbz monhelp	; H: list the commands
  363 f21e: ff 09        		smi 'Q'-'H'
  364 f220: c2 f1 1c     		lbz monq	; Q1 / Q0: Q on / off
  365 f223: c0 f9 13     		lbr monprompt	; anything else: back to the prompt, as before
  366 f226:              ;
  367 f226: f8 ff        monboot:	ldi high 0ff00h	; as @FF00: R0 = FF00, X = P = 0, then f_boot
  368 f228: b0           		phi r0
  369 f229: f8 00        		ldi low 0ff00h
  370 f22b: a0           		plo r0
  371 f22c: e0           		sex r0
  372 f22d: d0           		sep r0
  373 f22e:              ;
  374 f22e: f8 f2        monhelp:	ldi high montext
  375 f230: bf           		phi rf
  376 f231: f8 43        		ldi low montext
  377 f233: af           		plo rf
  378 f234: d4           		sep r4		; f_msg types the text at RF
  379 f235: ff 09        		dw 0ff09h
  380 f237: f8 f1        		ldi high montext2	; the rest of the list, at F11C
  381 f239: bf           		phi rf
  382 f23a: f8 34        		ldi low montext2
  383 f23c: af           		plo rf
  384 f23d: d4           		sep r4
  385 f23e: ff 09        		dw 0ff09h
  386 f240: c0 f9 13     		lbr monprompt
