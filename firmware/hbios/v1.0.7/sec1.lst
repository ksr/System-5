  892 f1b9:              ;
  893 f1b9:              ; The IO panel demo (Ken, 2026-11-12): @F1C0 from the monitor. Over and over: read the toggles (INP 4), show them on
  894 f1b9:              ; the LEDs (OUT 4), and set Q to match INPUT (EF1: pressed = Q on). Reset ends it. The monitor's @ starts it with
  895 f1b9:              ; P = 0 and X = 0, so R0 is its program counter; INP and OUT need X on a byte of RAM, so R1 points at 00F0 (the
  896 f1b9:              ; monitor's workspace: nothing else runs meanwhile).
  897 f1c0:              		org 0f1c0h
  898 f1c0: f8 00        pdemo:		ldi 00h		; R1 = 00F0, a byte of RAM for INP and OUT
  899 f1c2: b1           		phi r1
  900 f1c3: f8 f0        		ldi 0f0h
  901 f1c5: a1           		plo r1
  902 f1c6: e1           		sex r1
  903 f1c7: 6c           ploop:		inp 4		; the toggles to M(R1) and D
  904 f1c8: 64           		out 4		; M(R1) to the LEDs; R1 + 1
  905 f1c9: 21           		dec r1
  906 f1ca: 34 cf        		b1 pqon		; INPUT pressed (EF1): Q on
  907 f1cc: 7a           		req
  908 f1cd: 30 c7        		br ploop
  909 f1cf: 7b           pqon:		seq
  910 f1d0: 30 c7        		br ploop
  911 f1d2:              ;
  912 f1d2:              ; Key codes on the screen (Ken, 2026-11-17; v1.0.7): @F1E0 from the monitor. Self-contained (Ken): it calls nothing in
  913 f1d2:              ; the  or HBIOS. Over and over: wait for the keyboard's flag (EF3, set by the keyboard port's 1852 when a key is in
  914 f1d2:              ; it), read the key (INP 1) and write its code as text, 0x and two hex digits ("0x31" for the key 1), straight into
  915 f1d2:              ; the 6845's video RAM at the start of the bottom line (73C0), over the one before. Reset ends it. Once, at the start,
  916 f1d2:              ; the CRTC's cursor moves after the text: its low register (R15) = C4; R14 already holds the bottom line's, as the
  917 f1d2:              ; monitor left it after the command's Enter. The monitor's @ starts it with P = 0 and X = 0, so R0 is its program
  918 f1d2:              ; counter; R7 points at 00F0 (the monitor's workspace) for INP, R8 at the CRTC and then at the screen. The three bytes
  919 f1d2:              ; at F1E0 jump to the routine at FC50 (free in the , after v1.0.6's LBA code at FC31-FC44).
  920 f1e0:              		org 0f1e0h
  921 f1e0: c0 fc 50     kscr:		lbr kscreen
  922 f1e3:              ;
  923 fc50:              		org 0fc50h
  924 fc50: f8 78        kscreen:	ldi 78h		; R8 = 7800, the CRTC's address register
  925 fc52: b8           		phi r8
  926 fc53: f8 00        		ldi 00h
  927 fc55: a8           		plo r8
  928 fc56: f8 0f        		ldi 0fh		; R15, the cursor's low byte
  929 fc58: 58           		str r8
  930 fc59: 18           		inc r8
  931 fc5a: f8 c4        		ldi 0c4h	; the cursor after the text: 73C4
  932 fc5c: 58           		str r8
  933 fc5d: f8 00        		ldi 00h		; R7 = 00F0, a byte of RAM for INP
  934 fc5f: b7           		phi r7
  935 fc60: f8 f0        		ldi 0f0h
  936 fc62: a7           		plo r7
  937 fc63: e7           		sex r7
  938 fc64: 3e 64        swait:		bn3 swait	; wait for the keyboard's flag (EF3)
  939 fc66: 69           		inp 1		; read the keyboard: the key to M(R7) and D
  940 fc67: f8 73        		ldi 73h		; R8 = 73C0, the start of the bottom line
  941 fc69: b8           		phi r8
  942 fc6a: f8 c0        		ldi 0c0h
  943 fc6c: a8           		plo r8
  944 fc6d: f8 30        		ldi '0'
  945 fc6f: 58           		str r8
  946 fc70: 18           		inc r8
  947 fc71: f8 78        		ldi 'x'
  948 fc73: 58           		str r8
  949 fc74: 18           		inc r8
  950 fc75: 07           		ldn r7		; the high hex digit
  951 fc76: f6           		shr
  952 fc77: f6           		shr
  953 fc78: f6           		shr
  954 fc79: f6           		shr
  955 fc7a: ff 0a        		smi 0ah		; 0-9, or A-F (DF = 1)
  956 fc7c: 3b 80        		bnf sdig1
  957 fc7e: fc 07        		adi 07h		; A-F: 7 more
  958 fc80: fc 3a        sdig1:		adi 3ah		; to ASCII: '0' + the 10 taken off
  959 fc82: 58           		str r8
  960 fc83: 18           		inc r8
  961 fc84: 07           		ldn r7		; the low hex digit
  962 fc85: fa 0f        		ani 0fh
  963 fc87: ff 0a        		smi 0ah
  964 fc89: 3b 8d        		bnf sdig2
  965 fc8b: fc 07        		adi 07h
  966 fc8d: fc 3a        sdig2:		adi 3ah
  967 fc8f: 58           		str r8
  968 fc90: 30 64        		br swait
