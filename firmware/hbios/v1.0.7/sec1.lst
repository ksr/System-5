  398 f3ec:              ;
  399 f3ec:              ; D start:end - disassemble, one instruction a line: the address, the bytes, the mnemonic, as the emulator's
  400 f3ec:              ; disassembler writes them (so the two can be compared line for line). Every 14 lines it waits for a key: Esc,
  401 f3ec:              ; Ctrl-C or Q stops, any other key goes on. D start with no end shows 14 lines. Stops at the end address or when the
  402 f3ec:              ; address passes FFFF. Registers: RA the address, R9 the end, R8.0 lines left before a pause, R8.1 1 = an end was
  403 f3ec:              ; given, RB.0 the opcode, RB.1 its length, R7 a table or the operands, RC a counter. The line is built in the
  404 f3ec:              ; monitor's input buffer (0003): the address at 0003, the bytes at 0009, the mnemonic at 0013.
  405 f3ec:              ;
  406 0003:             dline_at:	equ 0003h
  407 0009:             dbytes_at:	equ 0009h
  408 0013:             dtext_at:	equ 0013h
  409 000e:             dlines:		equ 14
  410 f3ec: f8 00        mondis:		ldi high 0004h	; read the line again from after the D: f_hexin does not skip spaces
  411 f3ee: bf           		phi rf
  412 f3ef: f8 04        		ldi low 0004h
  413 f3f1: af           		plo rf
  414 f3f2: d4           		sep r4
  415 f3f3: ff 15        		dw f_ltrim
  416 f3f5: d4           		sep r4
  417 f3f6: ff 45        		dw f_hexin	; the start address
