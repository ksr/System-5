  263 f0cb: 5f           		str rf	       ; Get cursor position high
  264 f0cc: 2f           		dec rf
  265 f0cd: f8 0f        		ldi cur_l      ; CRTC low cursor register
  266 f0cf: 5f           		str rf         ; set CRTC Address register
  267 f0d0: 1f           		inc rf
  268 f0d1: 8c           		glo rc
  269 f0d2: 5f           		str rf	       ; get cursor positon low
