  143 f052:              ;
  144 f052:              ; Input/Output routines
  145 f052:              ;
  146 f052:              ; output a character
  147 f052:              ; Character to output in D
  148 f052:              ;
  149 f052: fa 7f        outchar: 	ani 07fh         ; Strip off high bit
  150 f054: ae           		plo re           ; Store Character to output in Register e.0
  151 f055: fb 7f        		xri 07fh         ; Check if character is is 07Fh (??? Why)
  152 f057: 32 eb        		bz  outnochar    ; If yes done
  153 f059: 8e           		glo re
  154 f05a:              
  155 f05a:              
  156 f05a:              
  157 f05a:              ;save registers
  158 f05a: e2           cont1:        	sex 2
  159 f05b: 8f           		glo rf
  160 f05c: 73           		stxd
  161 f05d: 9f           		ghi rf
  162 f05e: 73           		stxd
  163 f05f: 8e           		glo re
  164 f060: 73           		stxd
  165 f061: 9e           		ghi re
  166 f062: 73           		stxd
  167 f063: 8c           		glo rc
  168 f064: 73           		stxd
