  273 f0d3: f8 77        		ldi high vmem_ch
  274 f0d5: bf           		phi rf
  275 f0d6: f8 fe        		ldi low vmem_ch
  276 f0d8: af           		plo rf
  277 f0d9: 9c           		ghi rc
  278 f0da: 5f           		str rf
  279 f0db: 1f           		inc rf
  280 f0dc: 8c           		glo rc
