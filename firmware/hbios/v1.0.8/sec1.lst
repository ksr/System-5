  970 fc92:              ;
  971 fc92:              ; The IO panel card's real-time clock (Ken, 2026-11-18; v1.0.8): a DS12885 on two ports, as the card's JP4 is set: OUT 6
  972 fc92:              ; latches a register number, OUT 7 writes that register, INP 7 reads it. f_gettod (F815) and f_settod (F818) jump here
  973 fc92:              ; (in v1.0.4-v1.0.7 they jump to the 's error return), and f_getdev's answer has bit 4 (an RTC) set. The calls are
  974 fc92:              ; Mike Riley's, as his BIOS answers them for the ELF2000's DS1287 (orig_bios/bios.asm, e2k_gtod / e2k_stod): RF points
  975 fc92:              ; at six bytes, month, day, year, hour, minute, second; the year is ELF/OS's (years since 1972), kept in the clock's
  976 fc92:              ; year register as it is (28 years is a whole number of leap cycles, so the clock's leap years stay right). Binary,
  977 fc92:              ; 24-hour mode, daylight saving off. DF = 0: done; f_gettod returns DF = 1 (D = 1) when the clock is not running in
  978 fc92:              ; binary 24-hour mode: never set, or no clock at all (an INP of a port nobody drives reads FF, which is not 010 in DV).
  979 fc92:              ; Called through SCRT (R4 / R5), so X = 2 and R2 is the stack: a byte goes out from M(R2) (STR R2, OUT n, DEC R2).
  980 fc92:              ; Nothing but D, DF and RF changes.
  981 fc92:              ;
  982 fc92:              		org 0fc92h
  983 fc92: d4           rtcget:		sep r4		; register A: is the oscillator running (DV = 010)?
  984 fc93: fc dd        		dw rtcrd
  985 fc95: 0a           		db 0ah
  986 fc96: fa 70        		ani 70h
  987 fc98: fb 20        		xri 20h
  988 fc9a: ca fc d8     		lbnz rtcbad
  989 fc9d: d4           		sep r4		; register B: binary (DM) and 24-hour?
  990 fc9e: fc dd        		dw rtcrd
  991 fca0: 0b           		db 0bh
  992 fca1: fa 06        		ani 06h
  993 fca3: fb 06        		xri 06h
  994 fca5: ca fc d8     		lbnz rtcbad
  995 fca8: d4           rtcuip:		sep r4		; wait while an update is in progress (UIP, register A bit 7): then
  996 fca9: fc dd        		dw rtcrd	; the registers stay put for 244 us at least
  997 fcab: 0a           		db 0ah
  998 fcac: fa 80        		ani 80h
  999 fcae: ca fc a8     		lbnz rtcuip
 1000 fcb1: d4           		sep r4		; month
 1001 fcb2: fc dd        		dw rtcrd
 1002 fcb4: 08           		db 08h
 1003 fcb5: 5f           		str rf
 1004 fcb6: 1f           		inc rf
 1005 fcb7: d4           		sep r4		; day
 1006 fcb8: fc dd        		dw rtcrd
 1007 fcba: 07           		db 07h
 1008 fcbb: 5f           		str rf
 1009 fcbc: 1f           		inc rf
 1010 fcbd: d4           		sep r4		; year
 1011 fcbe: fc dd        		dw rtcrd
 1012 fcc0: 09           		db 09h
 1013 fcc1: 5f           		str rf
 1014 fcc2: 1f           		inc rf
 1015 fcc3: d4           		sep r4		; hour
 1016 fcc4: fc dd        		dw rtcrd
 1017 fcc6: 04           		db 04h
 1018 fcc7: 5f           		str rf
 1019 fcc8: 1f           		inc rf
 1020 fcc9: d4           		sep r4		; minute
 1021 fcca: fc dd        		dw rtcrd
 1022 fccc: 02           		db 02h
 1023 fccd: 5f           		str rf
 1024 fcce: 1f           		inc rf
 1025 fccf: d4           		sep r4		; second
 1026 fcd0: fc dd        		dw rtcrd
 1027 fcd2: 00           		db 00h
 1028 fcd3: 5f           		str rf
 1029 fcd4: 1f           		inc rf
 1030 fcd5: fc 00        		adi 0		; DF = 0: done
 1031 fcd7: d5           		sep r5
 1032 fcd8: f8 01        rtcbad:		ldi 1		; DF = 1, D = 1: the clock is not set (or not there)
 1033 fcda: ff 00        		smi 0
 1034 fcdc: d5           		sep r5
 1035 fcdd:              ;
 1036 fcdd:              ; rtcrd: D = the clock's register named by the byte after the call. rtcwr: D into it.
 1037 fcdd: 46           rtcrd:		lda r6		; the register number
 1038 fcde: 52           		str r2
 1039 fcdf: 66           		out 6		; latch it (AS)
 1040 fce0: 22           		dec r2
 1041 fce1: 6f           		inp 7		; read the register (DS): to M(R2) and D
 1042 fce2: d5           		sep r5
 1043 fce3: 73           rtcwr:		stxd		; the value, kept below the free byte
 1044 fce4: 46           		lda r6		; the register number
 1045 fce5: 52           		str r2
 1046 fce6: 66           		out 6		; latch it (AS)
 1047 fce7: 22           		dec r2
 1048 fce8: 60           		irx		; R2 at the value
 1049 fce9: 67           		out 7		; write it (R/W)
 1050 fcea: 22           		dec r2		; R2 back where it was
 1051 fceb: d5           		sep r5
 1052 fcec:              ;
 1053 fcec:              ; f_settod: start the oscillator (register A = 20h: DV = 010, no square wave), stop the count (SET) in binary 24-hour
 1054 fcec:              ; mode, write the six registers, then let it count (register B = 06h), as Mike's e2k_stod does but daylight saving off.
 1055 f7cd:              		org 0f7cdh
 1056 f7cd: f8 20        rtcset:		ldi 20h
 1057 f7cf: d4           		sep r4
 1058 f7d0: fc e3        		dw rtcwr
 1059 f7d2: 0a           		db 0ah
