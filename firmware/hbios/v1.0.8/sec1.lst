  172 f067:              ;
  173 f067:              ; Get character position in RC
  174 f067:              ;
  175 f067: f8 77        		ldi high vmem_ch ; Register F points to CRTC Address register
  176 f069: bf           		phi rf         ;
  177 f06a: f8 fe        		ldi low vmem_ch ;
  178 f06c: af           		plo rf         ;
  179 f06d: 0f           		ldn rf	       ; Get cursor position high
  180 f06e: bc           		phi rc         ; Store in RC.1
  181 f06f: 1f           		inc rf
  182 f070: 0f           		ldn rf	       ; Get cursor position low
  183 f071: ac           		plo rc	       ; Store in RC.0
  184 f072:              
  185 f072:              
  186 f072: 8e           	        glo re           ; Check for a control Character below 020h
  187 f073: fa e0                        ani 0e0h         ;
  188 f075: 3a bb        		bnz  normal      ; Normal character
  189 f077: 8e           		glo re           ; Check for carriage return 0dh
  190 f078: fb 0d        		xri 0dh          ;
  191 f07a: 32 88        		bz  cr           ; Process carriage return
  192 f07c: 8e           		glo re           ; Check for line feed 0ah
  193 f07d: fb 0a        		xri 0ah          ;
  194 f07f: 32 90        		bz  lf           ; Process line feed
  195 f081: 8e           		glo re           ; Check for backspace
  196 f082: fb 08        		xri 08h          ;
  197 f084: 32 b5        		bz  bs           ; process backspace
  198 f086: 30 de        		br  outdn
  199 f088:              ;
  200 f088:              ; Process a carriage return
  201 f088:              ;
  202 f088: f8 73        cr:		ldi high line23  ; Set Register C to start of line 23
  203 f08a: bc           		phi rc         	 ;
  204 f08b: f8 c0        		ldi low line23   ;
  205 f08d: ac           		plo rc           ;
  206 f08e: 30 be        		br  update       ; Update cursor position
  207 f090:              ;
  208 f090:              ; Process a line feed  >>>>>>redo registers
  209 f090:              ;
  210 f090: f8 70        lf:		ldi high vmem  ; Set Register E to start of Video memory
  211 f092: be           		phi re         ;
  212 f093: f8 00        		ldi low vmem   ;
  213 f095: ae           		plo re         ;
  214 f096: f8 70        		ldi high vmem+64 ; set Register F to 2nd line of Video memory
  215 f098: bf           		phi rf         ;
  216 f099: f8 40        		ldi low vmem+64 ;
  217 f09b: af           		plo rf         ;
  218 f09c:              ; Scrool loop, copy all lines up one
  219 f09c: 4f           sloop:          lda rf         ;
  220 f09d: 5e           		str re         ;
  221 f09e: 1e           		inc re         ;
  222 f09f: 9f           		ghi rf         ;
  223 f0a0: fb 78        		xri high vmem_end ; Is Register E past end of video memory
  224 f0a2: 3a 9c        		bnz  sloop     ; No, continue scrool loop
  225 f0a4:              ; Clear last line, Register D now point to first character position of last line
  226 f0a4: f8 73        		ldi high line23
  227 f0a6: be           		phi re
  228 f0a7: f8 c0        		ldi low line23
  229 f0a9: ae           		plo re
  230 f0aa: f8 20        erl:		ldi space       ; Space Character
  231 f0ac: 5e           	        str re         ;
  232 f0ad: 1e                  		inc re         ;
  233 f0ae: 9e                   	ghi re         ;
  234 f0af: fb 78                        xri high vmem_end ; Is register D past end of video memory
  235 f0b1: 3a aa                	bnz  erl       ; Continue erasing line
  236 f0b3:              ; Line feed done, return (Why not update cursor position)
  237 f0b3: 30 be        		br update
  238 f0b5:              ;
  239 f0b5:              ; Process Back Space
  240 f0b5:              ;
  241 f0b5: 2c           bs:             dec rc         ; Register C is character pointer
  242 f0b6: f8 20        		ldi space       ; Clear postion with a space character
  243 f0b8: 5c           		str rc         ;
  244 f0b9: 30 be        	        br  update     ; Update Cursor postion
  245 f0bb:              ;
  246 f0bb:              ; Process Normal Character
  247 f0bb:              ;
  248 f0bb: 8e           normal:         glo re         ; Register F.1 contains character
  249 f0bc: 5c           		str rc         ; Store at register C, Character pointer
  250 f0bd: 1c                           inc rc         ;
  251 f0be:              ;
  252 f0be:              ; Update Cursor position
  253 f0be:              ;
  254 f0be:              update:
  255 f0be: f8 78        		ldi high crtca
