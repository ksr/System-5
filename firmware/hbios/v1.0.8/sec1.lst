  341 f20c:              ;
  342 f20c:              ; Monitor commands added in HBIOS v1.0.5 (Ken, 2026-11-12): H lists the commands, B boots the OS from the CF card,
  343 f20c:              ; D start:end disassembles (a screenful at a time, waiting for a key; D start alone shows one screenful), Q1 / Q0
  344 f20c:              ; turn the 1802's Q output on / off. @F1C0 runs a small IO panel demo.
  345 f20c:              ; Mike Riley's monitor (F900) goes back to its prompt when it does not know a command. build.py patches that one
  346 f20c:              ; branch (F940: BNZ F913 becomes BNZ F9EB) and puts LBR monext in the 's free bytes at F9EB, so an unknown
  347 f20c:              ; command comes here. On entry: RC.1 = the command character, RA = the hex number typed after it, X = 2, P = 3,
  348 f20c:              ; SCRT set up (R4 call, R5 return). F913 is the monitor's prompt: it types test> and reads the next line.
  349 f20c:              ;
  350 f913:             monprompt:	equ 0f913h
  351 ff09:             f_msg:		equ 0ff09h	; type the zero-terminated text at RF
  352 ff15:             f_ltrim:	equ 0ff15h	; RF past spaces
  353 ff45:             f_hexin:	equ 0ff45h	; RD = the hex number at RF; RF after it
  354 ff48:             f_hexout2:	equ 0ff48h	; two hex digits of RD.0 to RF, RF after them
  355 ff4b:             f_hexout4:	equ 0ff4bh	; four hex digits of RD to RF, RF after them
  356 f20c: 9c           monext:		ghi rc		; the command character
  357 f20d: fa df        		ani 0dfh	; lower case to upper case (b -> B, h -> H)
  358 f20f: ff 42        		smi 'B'
  359 f211: c2 f2 26     		lbz monboot	; B: boot the OS
  360 f214: ff 02        		smi 'D'-'B'
  361 f216: c2 f3 ec     		lbz mondis	; D: disassemble
  362 f219: ff 04        		smi 'H'-'D'
  363 f21b: c2 f2 2e     		lbz monhelp	; H: list the commands
  364 f21e: ff 09        		smi 'Q'-'H'
  365 f220: c2 f1 1c     		lbz monq	; Q1 / Q0: Q on / off
  366 f223: c0 f9 13     		lbr monprompt	; anything else: back to the prompt, as before
  367 f226:              ;
  368 f226: f8 ff        monboot:	ldi high 0ff00h	; as @FF00: R0 = FF00, X = P = 0, then f_boot
  369 f228: b0           		phi r0
  370 f229: f8 00        		ldi low 0ff00h
  371 f22b: a0           		plo r0
  372 f22c: e0           		sex r0
  373 f22d: d0           		sep r0
  374 f22e:              ;
  375 f22e: f8 f2        monhelp:	ldi high montext
  376 f230: bf           		phi rf
  377 f231: f8 43        		ldi low montext
  378 f233: af           		plo rf
  379 f234: d4           		sep r4		; f_msg types the text at RF
  380 f235: ff 09        		dw 0ff09h
  381 f237: f8 f1        		ldi high montext2	; the rest of the list, at F11C
  382 f239: bf           		phi rf
  383 f23a: f8 34        		ldi low montext2
  384 f23c: af           		plo rf
  385 f23d: d4           		sep r4
  386 f23e: ff 09        		dw 0ff09h
  387 f240: c0 f9 13     		lbr monprompt
