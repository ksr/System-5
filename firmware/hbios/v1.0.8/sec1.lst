 1061 f7d5: d4           		sep r4
 1062 f7d6: fc e3        		dw rtcwr
 1063 f7d8: 0b           		db 0bh
 1064 f7d9: 4f           		lda rf		; month
 1065 f7da: d4           		sep r4
 1066 f7db: fc e3        		dw rtcwr
 1067 f7dd: 08           		db 08h
 1068 f7de: 4f           		lda rf		; day
 1069 f7df: d4           		sep r4
 1070 f7e0: fc e3        		dw rtcwr
 1071 f7e2: 07           		db 07h
 1072 f7e3: 4f           		lda rf		; year
 1073 f7e4: d4           		sep r4
 1074 f7e5: fc e3        		dw rtcwr
 1075 f7e7: 09           		db 09h
 1076 f7e8: 4f           		lda rf		; hour
 1077 f7e9: d4           		sep r4
 1078 f7ea: fc e3        		dw rtcwr
 1079 f7ec: 04           		db 04h
 1080 f7ed: 4f           		lda rf		; minute
 1081 f7ee: d4           		sep r4
 1082 f7ef: fc e3        		dw rtcwr
 1083 f7f1: 02           		db 02h
 1084 f7f2: 4f           		lda rf		; second
 1085 f7f3: d4           		sep r4
 1086 f7f4: fc e3        		dw rtcwr
