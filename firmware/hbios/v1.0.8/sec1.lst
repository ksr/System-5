  893 f1b9:              ;
  894 f1b9:              ; The IO panel demo (Ken, 2026-11-12): @F1C0 from the monitor. Over and over: read the toggles (INP 4), show them on
  895 f1b9:              ; the LEDs (OUT 4), and set Q to match INPUT (EF1: pressed = Q on). Reset ends it. The monitor's @ starts it with
  896 f1b9:              ; P = 0 and X = 0, so R0 is its program counter; INP and OUT need X on a byte of RAM, so R1 points at 00F0 (the
  897 f1b9:              ; monitor's workspace: nothing else runs meanwhile).
  898 f1c0:              		org 0f1c0h
  899 f1c0: f8 00        pdemo:		ldi 00h		; R1 = 00F0, a byte of RAM for INP and OUT
  900 f1c2: b1           		phi r1
  901 f1c3: f8 f0        		ldi 0f0h
  902 f1c5: a1           		plo r1
  903 f1c6: e1           		sex r1
  904 f1c7: 6c           ploop:		inp 4		; the toggles to M(R1) and D
  905 f1c8: 64           		out 4		; M(R1) to the LEDs; R1 + 1
  906 f1c9: 21           		dec r1
  907 f1ca: 34 cf        		b1 pqon		; INPUT pressed (EF1): Q on
  908 f1cc: 7a           		req
  909 f1cd: 30 c7        		br ploop
  910 f1cf: 7b           pqon:		seq
  911 f1d0: 30 c7        		br ploop
  912 f1d2:              ;
  913 f1d2:              ; Key codes on the screen (Ken, 2026-11-17; v1.0.7): @F1E0 from the monitor. Self-contained (Ken): it calls nothing in
  914 f1d2:              ; the  or HBIOS. Over and over: wait for the keyboard's flag (EF3, set by the keyboard port's 1852 when a key is in
  915 f1d2:              ; it), read the key (INP 1) and write its code as text, 0x and two hex digits ("0x31" for the key 1), straight into
  916 f1d2:              ; the 6845's video RAM at the start of the bottom line (73C0), over the one before. Reset ends it. Once, at the start,
  917 f1d2:              ; the CRTC's cursor moves after the text: its low register (R15) = C4; R14 already holds the bottom line's, as the
  918 f1d2:              ; monitor left it after the command's Enter. The monitor's @ starts it with P = 0 and X = 0, so R0 is its program
  919 f1d2:              ; counter; R7 points at 00F0 (the monitor's workspace) for INP, R8 at the CRTC and then at the screen. The three bytes
  920 f1d2:              ; at F1E0 jump to the routine at FC50 (free in the , after v1.0.6's LBA code at FC31-FC44).
  921 f1e0:              		org 0f1e0h
  922 f1e0: c0 fc 50     kscr:		lbr kscreen
  923 f1e3:              ;
  924 fc50:              		org 0fc50h
  925 fc50: f8 78        kscreen:	ldi 78h		; R8 = 7800, the CRTC's address register
  926 fc52: b8           		phi r8
  927 fc53: f8 00        		ldi 00h
  928 fc55: a8           		plo r8
  929 fc56: f8 0f        		ldi 0fh		; R15, the cursor's low byte
  930 fc58: 58           		str r8
  931 fc59: 18           		inc r8
  932 fc5a: f8 c4        		ldi 0c4h	; the cursor after the text: 73C4
  933 fc5c: 58           		str r8
  934 fc5d: f8 00        		ldi 00h		; R7 = 00F0, a byte of RAM for INP
  935 fc5f: b7           		phi r7
  936 fc60: f8 f0        		ldi 0f0h
  937 fc62: a7           		plo r7
  938 fc63: e7           		sex r7
  939 fc64: 3e 64        swait:		bn3 swait	; wait for the keyboard's flag (EF3)
  940 fc66: 69           		inp 1		; read the keyboard: the key to M(R7) and D
  941 fc67: f8 73        		ldi 73h		; R8 = 73C0, the start of the bottom line
  942 fc69: b8           		phi r8
  943 fc6a: f8 c0        		ldi 0c0h
