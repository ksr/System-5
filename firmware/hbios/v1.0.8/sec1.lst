  144 f052:              ;
  145 f052:              ; Input/Output routines
  146 f052:              ;
  147 f052:              ; output a character
  148 f052:              ; Character to output in D
  149 f052:              ;
  150 f052: fa 7f        outchar: 	ani 07fh         ; Strip off high bit
  151 f054: ae           		plo re           ; Store Character to output in Register e.0
  152 f055: fb 7f        		xri 07fh         ; Check if character is is 07Fh (??? Why)
  153 f057: 32 eb        		bz  outnochar    ; If yes done
  154 f059: 8e           		glo re
  155 f05a:              
  156 f05a:              
  157 f05a:              
  158 f05a:              ;save registers
  159 f05a: e2           cont1:        	sex 2
  160 f05b: 8f           		glo rf
  161 f05c: 73           		stxd
  162 f05d: 9f           		ghi rf
  163 f05e: 73           		stxd
  164 f05f: 8e           		glo re
  165 f060: 73           		stxd
  166 f061: 9e           		ghi re
  167 f062: 73           		stxd
  168 f063: 8c           		glo rc
  169 f064: 73           		stxd
