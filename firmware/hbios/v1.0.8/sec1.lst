  263 f0ca: 1f           		inc rf
  264 f0cb: 5f           		str rf	       ; Get cursor position high
  265 f0cc: 2f           		dec rf
  266 f0cd: f8 0f        		ldi cur_l      ; CRTC low cursor register
  267 f0cf: 5f           		str rf         ; set CRTC Address register
  268 f0d0: 1f           		inc rf
  269 f0d1: 8c           		glo rc
  270 f0d2: 5f           		str rf	       ; get cursor positon low
