  274 f0d3: f8 77        		ldi high vmem_ch
  275 f0d5: bf           		phi rf
  276 f0d6: f8 fe        		ldi low vmem_ch
  277 f0d8: af           		plo rf
  278 f0d9: 9c           		ghi rc
  279 f0da: 5f           		str rf
  280 f0db: 1f           		inc rf
  281 f0dc: 8c           		glo rc
  282 f0dd: 5f           		str rf
