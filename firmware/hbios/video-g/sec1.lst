  444 f3ec:              ;
  445 f3ec:              ; D start:end - disassemble, one instruction a line: the address, the bytes, the mnemonic, as the emulator's
  446 f3ec:              ; disassembler writes them (so the two can be compared line for line). Every 14 lines it waits for a key: Esc,
  447 f3ec:              ; Ctrl-C or Q stops, any other key goes on. D start with no end shows 14 lines. Stops at the end address or when the
  448 f3ec:              ; address passes FFFF. Registers: RA the address, R9 the end, R8.0 lines left before a pause, R8.1 1 = an end was
  449 f3ec:              ; given, RB.0 the opcode, RB.1 its length, R7 a table or the operands, RC a counter. The line is built in the
  450 f3ec:              ; monitor's input buffer (0003): the address at 0003, the bytes at 0009, the mnemonic at 0013.
  451 f3ec:              ;
  452 0003:             dline_at:	equ 0003h
  453 0009:             dbytes_at:	equ 0009h
  454 0013:             dtext_at:	equ 0013h
  455 000e:             dlines:		equ 14
  456 f3ec: f8 00        mondis:		ldi high 0004h	; read the line again from after the D: f_hexin does not skip spaces
  457 f3ee: bf           		phi rf
  458 f3ef: f8 04        		ldi low 0004h
  459 f3f1: af           		plo rf
  460 f3f2: d4           		sep r4
  461 f3f3: ff 15        		dw f_ltrim
  462 f3f5: d4           		sep r4
  463 f3f6: ff 45        		dw f_hexin	; the start address
  464 f3f8: 9d           		ghi rd
  465 f3f9: ba           		phi ra
  466 f3fa: 8d           		glo rd
  467 f3fb: aa           		plo ra
  468 f3fc: d4           		sep r4
  469 f3fd: ff 15        		dw f_ltrim
  470 f3ff: 0f           		ldn rf		; ':' or '-' between the two addresses
  471 f400: fb 3a        		xri ':'
  472 f402: c2 f4 0a     		lbz dskip
  473 f405: fb 17        		xri ':'^'-'
  474 f407: ca f4 0e     		lbnz dnosep
  475 f40a: 1f           dskip:		inc rf
  476 f40b: d4           		sep r4
  477 f40c: ff 15        		dw f_ltrim
  478 f40e: 0f           dnosep:		ldn rf
  479 f40f: c2 f4 1c     		lbz dnoend	; nothing more on the line: no end address
  480 f412: d4           		sep r4
