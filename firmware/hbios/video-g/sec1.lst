   78 f000:              		org 0f000h
   79 f000: f8 f0        boot:		ldi high boot	;Trigger Boot rom remap
   80 f002: b0           		phi r0		;
   81 f003: f8 78        		ldi high vstat	; the control register (7804) = 00: text on, graphics, XOR and mouse off, page 0
   82 f005: bf           		phi rf
   83 f006: f8 04        		ldi low vstat
   84 f008: af           		plo rf
   85 f009: f8 00        		ldi 00h
   86 f00b: 5f           		str rf
   87 f00c: f8 00        		ldi low crtca	; RF = 7800, the 6845's address register
   88 f00e: af           		plo rf
   89 f00f: f8 f0        		ldi high vtable ; Register D set to vtable (CRTC register, value pairs)
   90 f011: bd           		phi rd          ;
   91 f012: f8 3f        		ldi low vtable  ;
   92 f014: ad           		plo rd          ;
   93 f015:              ;
   94 f015:              ; Load Video Paramters into CRTC
   95 f015:              ;
   96 f015: 4d           vload:          lda rd          ; register number to the 6845's address register (7800)
   97 f016: 5f           		str rf
   98 f017: 1f           		inc rf
   99 f018: 4d           	        lda rd          ; its value to the data register (7801)
  100 f019: 5f           		str rf
  101 f01a: 2f           		dec rf
  102 f01b: 8d           	        glo rd          ; end of the table?
  103 f01c: fb 5f        	        xri vtable_end.0
  104 f01e: 3a 15        	        bnz  vload      ; If not load next CRTC Video paramter
  105 f020:              ;
  106 f020:              ; Clear Video memory (with space charachter)
  107 f020:              ;
  108 f020:              
  109 f020: f8 70        		ldi high vmem   ; Register F set to start of Video memory
  110 f022: bf           		phi rf          ;
  111 f023: f8 00        		ldi low vmem    ;
  112 f025: af           		plo rf          ;
  113 f026: f8 20        clear:          ldi space        ; Load D  space character
  114 f028: 5f           		str rf          ; Sstore in Video memory
  115 f029: 1f           		inc rf          ; Increment Register F to next video memory location
  116 f02a: 9f           		ghi rf          ; Check if past end of video memory
  117 f02b: fb 78        		xri high vmem_end ; Logical XOR D with value
  118 f02d: 3a 26        		bnz clear       ; Short branch on D!=0
  119 f02f:              ;
  120 f02f:              ; Store cursor position in memory
  121 f02f:              ;
  122 f02f: f8 77        		ldi high vmem_ch
  123 f031: bf           		phi rf
  124 f032: f8 fe        		ldi low vmem_ch
  125 f034: af           		plo rf
  126 f035: f8 76        		ldi high line24
  127 f037: 5f           		str rf
  128 f038: 1f           		inc rf
  129 f039: f8 00        		ldi low line24
  130 f03b: 5f           		str rf
  131 f03c:              ;
  132 f03c:              ; Initialization complete jump to real start
  133 f03c:              ;
  134 f03c: c0 f2 09     		lbr  cold_entry      ; Long branch
  135 f03f:              ;
  136 f03f:              ; Video Paramters: (register, value) pairs, 64 x 25 NTSC (hardware/video-g/DESIGN.md section 2)
  137 f03f:              ;
  138 f03f: 00 5e        vtable:		 db 0,94  ; R0 total number of horiz chars
  139 f041: 01 40        		 db 1,64  ; R1 number of horiz chars displayed
  140 f043: 02 4c        		 db 2,76  ; R2 Horiz sync position (chars)
  141 f045: 03 08        		 db 3,8   ; R3 VSYNC/HSYNC Widths
  142 f047: 04 1f        		 db 4,31  ; R4 Vert Total (chars)
  143 f049: 05 06        		 db 5,6   ; R5 Vert total Adjust (scan lines)
  144 f04b: 06 19        		 db 6,25  ; R6 Vert displayed (chars)
  145 f04d: 07 1c        		 db 7,28  ; R7 Vert Sync position (chars)
  146 f04f: 08 00        		 db 8,0   ; R8 mode contro;
  147 f051: 09 07        		 db 9,7   ; R9 scan lines/char (8)
  148 f053: 0a 40        		 db 10,64 ; R10 cursor start (scan line/char) + blink rate
  149 f055: 0b 07        		 db 11,7  ; R11 cursor end (scan line/char)
  150 f057: 0c 00        		 db 12,0  ; R12 display addr start high
  151 f059: 0d 00        		 db 13,0  ; R13 display addr start low
  152 f05b: 0e 06        		 db 14,6  ; R14 Cursor position high (row 24)
  153 f05d: 0f 00        		 db 15,0  ; R15 Cursor positon low
  154 f05f:              vtable_end:
