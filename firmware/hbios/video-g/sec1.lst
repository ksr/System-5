 1054 f7dd: 08           		db 08h
 1055 f7de: 4f           		lda rf		; day
 1056 f7df: d4           		sep r4
 1057 f7e0: fc e3        		dw rtcwr
 1058 f7e2: 07           		db 07h
 1059 f7e3: 4f           		lda rf		; year
 1060 f7e4: d4           		sep r4
 1061 f7e5: fc e3        		dw rtcwr
 1062 f7e7: 09           		db 09h
 1063 f7e8: 4f           		lda rf		; hour
 1064 f7e9: d4           		sep r4
 1065 f7ea: fc e3        		dw rtcwr
 1066 f7ec: 04           		db 04h
 1067 f7ed: 4f           		lda rf		; minute
