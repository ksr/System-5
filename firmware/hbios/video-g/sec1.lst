    1 0000:              ;
    2 0000:              ; HBIOS for VIDEO-G 1.0 (System-5), made 2026-11-01 from HBIOS v1.0.4 (firmware/hbios/v1.0.4/sec1.asm, unchanged).
    3 0000:              ; Changes, all for the VIDEO-G TEXT board (hardware/video-g/DESIGN.md sections 2, 3 and 8):
    4 0000:              ;   - VIDEO-G is memory-mapped (2026-11-17, hardware/video-g/DESIGN.md section 3): the 6845 at 7800 (address
    5 0000:              ;     register) and 7801 (data), as on the 6845 card; the key at 7802; status / control at 7804 (KEY-READY = bit 0)
    6 0000:              ;   - the 64 x 25 NTSC table (R0-R9 = 94,64,76,8,31,6,25,28,0,7; 8 x 8 cells), cursor rows 0-7
    7 0000:              ;   - the bottom row is row 24 (7600); the cursor is kept in 77FE/77FF as before (not displayed at 25 rows)
    8 0000:              ;   - the control register (7804) = 00 at start: text on, graphics, XOR and mouse off, page 0
    9 0000:              ;   - inchar and brk poll KEY-READY in the status register instead of EF3 (any CPU card: CPU Rev D takes the bus
   10 0000:              ;     -EF on EF4), read the key at 7802 and keep every register but D
   11 0000:              ;   - a line feed scrolls only the 24 visible rows (an unrolled copy, 1536 bytes) and blanks row 24:
   12 0000:              ;     about 45 ms at 1.76 MHz, against 168 ms for the v1.0.4 copy of all of 7040-77FF
   13 0000:              ;   - the cursor address sent to R14/R15 is the 6845 address (RC - 7000), not the high byte of RC AND 3F
   14 0000:              ;   - a key of 80h or more (the VIDEO-G keyboard: F1-F12 80-8B, Home Up PgUp Left 5 Right End Down PgDn Ins Del
   15 0000:              ;     90-9A, with Shift C0-DA) is returned by inchar but not echoed (outchar strips bit 7: it would print junk)
   16 0000:              ; build.py also gives it v1.0.6's disk fix (LBA mode, FBC1 / FBDF / FC31-FC44), which Elf/OS v5 needs.
   17 0000:              ; Everything else (the jump table at F200, the Riley code) is as in v1.0.4.
   18 0000:              ;
   19 0000:              ; Define BIOS to generate code for use with ELFOS BIOS
   20 0000:              ;
   21 0000:              
   22 0000:              
   23 0000:              
   24 0000:              ;
   25 0000:              ; Define 6845VIDEOLOWER when video card (REV B and beyond) supports lower
   26 0000:              ; case characters and there is no need to force characters to upper case
   27 0000:              ;
   28 0000:              
   29 0000:              
   30 0000:              
   31 0000:              ;
   32 0000:              ; Define BASIC if the is for use with Tiny basic and not for ELFOS
   33 0000:              ;
   34 0000:              
   35 0000:              ;
   36 0000:              ; minimon is entry point in ELFOS  to jump to once bios has booted
   37 0000:              ;
   38 0000:              
   39 ff54:             minimon:	equ     0ff54h
   40 0000:              
   41 7800:             crtca:		equ	07800h		; the 6845: address register (VIDEO-G, memory-mapped)
   42 7801:             crtcd:		equ	07801h		; the 6845: data register
   43 7802:             kdata:		equ	07802h		; the key (reading it clears KEY-READY)
   44 7804:             vstat:		equ	07804h		; status (read; bit 0 = KEY-READY) and control (write)
   45 000e:             cur_h:		equ     14		; Cursor postion high
   46 000f:             cur_l:		equ     15		; Cursor postion low
   47 0000:              
   48 7000:             vmem:		equ	07000h		; Start of video memory
   49 7800:             vmem_end:	equ     07800h		; End of video memory
   50 77fe:             vmem_ch:	equ	vmem_end-2
   51 77ff:             vmem_cl:	equ     vmem_end-1
   52 0020:             space:		equ	020h		; Ascii Space
   53 0019:             rows:		equ	25		; VIDEO-G NTSC: 64 x 25
   54 7600:             line24:		equ     vmem+(64*24)	; the bottom row
   55 7640:             vis_end:	equ	vmem+(64*25)	; end of the visible text (7640)
   56 0000:              
   57 ff00:             JUMPTBL:	equ	0ff00h
   58 f700:             basic_start:	equ	0f700h
   59 feff:             basic_end:	equ	0feffh
   60 0100:             basic_dest:	equ	00100h
   61 f500:             basmon:		equ	0f500h
   62 0000:              
   63 f000:              		org 0f000h
   64 f000: f8 f0        boot:		ldi high boot	;Trigger Boot rom remap
   65 f002: b0           		phi r0		;
   66 f003: f8 78        		ldi high vstat	; the control register (7804) = 00: text on, graphics, XOR and mouse off, page 0
   67 f005: bf           		phi rf
   68 f006: f8 04        		ldi low vstat
   69 f008: af           		plo rf
   70 f009: f8 00        		ldi 00h
   71 f00b: 5f           		str rf
   72 f00c: f8 00        		ldi low crtca	; RF = 7800, the 6845's address register
   73 f00e: af           		plo rf
   74 f00f: f8 f0        		ldi high vtable ; Register D set to vtable (CRTC register, value pairs)
   75 f011: bd           		phi rd          ;
   76 f012: f8 3f        		ldi low vtable  ;
   77 f014: ad           		plo rd          ;
   78 f015:              ;
   79 f015:              ; Load Video Paramters into CRTC
   80 f015:              ;
   81 f015: 4d           vload:          lda rd          ; register number to the 6845's address register (7800)
   82 f016: 5f           		str rf
   83 f017: 1f           		inc rf
   84 f018: 4d           	        lda rd          ; its value to the data register (7801)
   85 f019: 5f           		str rf
   86 f01a: 2f           		dec rf
   87 f01b: 8d           	        glo rd          ; end of the table?
   88 f01c: fb 5f        	        xri vtable_end.0
   89 f01e: 3a 15        	        bnz  vload      ; If not load next CRTC Video paramter
   90 f020:              ;
   91 f020:              ; Clear Video memory (with space charachter)
   92 f020:              ;
   93 f020:              
   94 f020: f8 70        		ldi high vmem   ; Register F set to start of Video memory
   95 f022: bf           		phi rf          ;
   96 f023: f8 00        		ldi low vmem    ;
   97 f025: af           		plo rf          ;
   98 f026: f8 20        clear:          ldi space        ; Load D  space character
   99 f028: 5f           		str rf          ; Sstore in Video memory
  100 f029: 1f           		inc rf          ; Increment Register F to next video memory location
  101 f02a: 9f           		ghi rf          ; Check if past end of video memory
  102 f02b: fb 78        		xri high vmem_end ; Logical XOR D with value
  103 f02d: 3a 26        		bnz clear       ; Short branch on D!=0
  104 f02f:              ;
  105 f02f:              ; Store cursor position in memory
  106 f02f:              ;
  107 f02f: f8 77        		ldi high vmem_ch
  108 f031: bf           		phi rf
  109 f032: f8 fe        		ldi low vmem_ch
  110 f034: af           		plo rf
  111 f035: f8 76        		ldi high line24
  112 f037: 5f           		str rf
  113 f038: 1f           		inc rf
  114 f039: f8 00        		ldi low line24
  115 f03b: 5f           		str rf
  116 f03c:              ;
  117 f03c:              ; Initialization complete jump to real start
  118 f03c:              ;
  119 f03c: c0 f2 09     		lbr  cold_entry      ; Long branch
  120 f03f:              ;
  121 f03f:              ; Video Paramters: (register, value) pairs, 64 x 25 NTSC (hardware/video-g/DESIGN.md section 2)
  122 f03f:              ;
  123 f03f: 00 5e        vtable:		 db 0,94  ; R0 total number of horiz chars
  124 f041: 01 40        		 db 1,64  ; R1 number of horiz chars displayed
  125 f043: 02 4c        		 db 2,76  ; R2 Horiz sync position (chars)
  126 f045: 03 08        		 db 3,8   ; R3 VSYNC/HSYNC Widths
  127 f047: 04 1f        		 db 4,31  ; R4 Vert Total (chars)
  128 f049: 05 06        		 db 5,6   ; R5 Vert total Adjust (scan lines)
  129 f04b: 06 19        		 db 6,25  ; R6 Vert displayed (chars)
  130 f04d: 07 1c        		 db 7,28  ; R7 Vert Sync position (chars)
  131 f04f: 08 00        		 db 8,0   ; R8 mode contro;
  132 f051: 09 07        		 db 9,7   ; R9 scan lines/char (8)
  133 f053: 0a 40        		 db 10,64 ; R10 cursor start (scan line/char) + blink rate
  134 f055: 0b 07        		 db 11,7  ; R11 cursor end (scan line/char)
  135 f057: 0c 00        		 db 12,0  ; R12 display addr start high
  136 f059: 0d 00        		 db 13,0  ; R13 display addr start low
  137 f05b: 0e 06        		 db 14,6  ; R14 Cursor position high (row 24)
  138 f05d: 0f 00        		 db 15,0  ; R15 Cursor positon low
  139 f05f:              vtable_end:
  140 f05f:              ;
  141 f05f:              ; Input/Output routines
  142 f05f:              ;
  143 f05f:              ; output a character
  144 f05f:              ; Character to output in D
  145 f05f:              ;
  146 f05f: fa 7f        outchar: 	ani 07fh         ; Strip off high bit
  147 f061: ae           		plo re           ; Store Character to output in Register e.0
  148 f062: fb 7f        		xri 07fh         ; Check if character is is 07Fh (??? Why)
  149 f064: 32 d6        		bz  outnochar    ; If yes done
  150 f066: 8e           		glo re
