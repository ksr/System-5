  333 f10b: 0f           inwait:		ldn rf		; Wait for an input character: KEY-READY (bit 0), polled, not EF3 (CPU Rev D has -EF
  334 f10c: f6           		shr		; on EF4)
  335 f10d: 3b 0b        		bnf inwait
  336 f10f: f8 02        		ldi low kdata	; RF = 7802: Read character (the read clears KEY-READY)
  337 f111: af           		plo rf
  338 f112: 0f           		ldn rf
  339 f113: 52           		str r2		; the character, in the free byte below the saved RF
  340 f114: fa 80        		ani 080h       ; VIDEO-G: F1-F12, arrows etc. send 80h and up: return them, but no echo
  341 f116: 3a 1e        		bnz innoecho
  342 f118: 02           		ldn r2         ; the character again
