  182 f073: 73           		stxd
  183 f074:              ;
  184 f074:              ; Get character position in RC
  185 f074:              ;
  186 f074: f8 77        		ldi high vmem_ch ; Register F points to CRTC Address register
  187 f076: bf           		phi rf         ;
  188 f077: f8 fe        		ldi low vmem_ch ;
  189 f079: af           		plo rf         ;
  190 f07a: 0f           		ldn rf	       ; Get cursor position high
  191 f07b: bc           		phi rc         ; Store in RC.1
  192 f07c: 1f           		inc rf
  193 f07d: 0f           		ldn rf	       ; Get cursor position low
  194 f07e: ac           		plo rc	       ; Store in RC.0
  195 f07f:              
  196 f07f:              
  197 f07f: 8e           	        glo re           ; Check for a control Character below 020h
  198 f080: fa e0                        ani 0e0h         ;
  199 f082: 3a a6        		bnz  normal      ; Normal character
  200 f084: 8e           		glo re           ; Check for carriage return 0dh
  201 f085: fb 0d        		xri 0dh          ;
  202 f087: 32 95        		bz  cr           ; Process carriage return
  203 f089: 8e           		glo re           ; Check for line feed 0ah
  204 f08a: fb 0a        		xri 0ah          ;
  205 f08c: 32 9d        		bz  lf           ; Process line feed
  206 f08e: 8e           		glo re           ; Check for backspace
  207 f08f: fb 08        		xri 08h          ;
  208 f091: 32 a0        		bz  bs           ; process backspace
  209 f093: 30 c9        		br  outdn
  210 f095:              ;
  211 f095:              ; Process a carriage return
  212 f095:              ;
  213 f095: f8 76        cr:		ldi high line24  ; Set Register C to start of the bottom row
  214 f097: bc           		phi rc         	 ;
  215 f098: f8 00        		ldi low line24   ;
  216 f09a: ac           		plo rc           ;
  217 f09b: 30 a9        		br  update       ; Update cursor position
  218 f09d:              ;
  219 f09d:              ; Process a line feed: scroll the visible rows (at F300)
  220 f09d:              ;
  221 f09d: c0 fc 45     lf:		lbr scroll
  222 f0a0:              ;
  223 f0a0:              ; Process Back Space
  224 f0a0:              ;
