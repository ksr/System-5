  167 f067:              
  168 f067:              
  169 f067:              ;save registers
  170 f067: e2           cont1:        	sex 2
  171 f068: 8f           		glo rf
  172 f069: 73           		stxd
  173 f06a: 9f           		ghi rf
  174 f06b: 73           		stxd
  175 f06c: 8e           		glo re
  176 f06d: 73           		stxd
  177 f06e: 9e           		ghi re
  178 f06f: 73           		stxd
  179 f070: 8c           		glo rc
  180 f071: 73           		stxd
