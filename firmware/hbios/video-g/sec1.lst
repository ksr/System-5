  168 f074:              ;
  169 f074:              ; Get character position in RC
  170 f074:              ;
  171 f074: f8 77        		ldi high vmem_ch ; Register F points to CRTC Address register
  172 f076: bf           		phi rf         ;
  173 f077: f8 fe        		ldi low vmem_ch ;
  174 f079: af           		plo rf         ;
  175 f07a: 0f           		ldn rf	       ; Get cursor position high
  176 f07b: bc           		phi rc         ; Store in RC.1
  177 f07c: 1f           		inc rf
  178 f07d: 0f           		ldn rf	       ; Get cursor position low
  179 f07e: ac           		plo rc	       ; Store in RC.0
  180 f07f:              
  181 f07f:              
  182 f07f: 8e           	        glo re           ; Check for a control Character below 020h
  183 f080: fa e0                        ani 0e0h         ;
  184 f082: 3a a6        		bnz  normal      ; Normal character
  185 f084: 8e           		glo re           ; Check for carriage return 0dh
  186 f085: fb 0d        		xri 0dh          ;
  187 f087: 32 95        		bz  cr           ; Process carriage return
  188 f089: 8e           		glo re           ; Check for line feed 0ah
  189 f08a: fb 0a        		xri 0ah          ;
  190 f08c: 32 9d        		bz  lf           ; Process line feed
  191 f08e: 8e           		glo re           ; Check for backspace
  192 f08f: fb 08        		xri 08h          ;
  193 f091: 32 a0        		bz  bs           ; process backspace
  194 f093: 30 c9        		br  outdn
  195 f095:              ;
  196 f095:              ; Process a carriage return
  197 f095:              ;
  198 f095: f8 76        cr:		ldi high line24  ; Set Register C to start of the bottom row
  199 f097: bc           		phi rc         	 ;
  200 f098: f8 00        		ldi low line24   ;
  201 f09a: ac           		plo rc           ;
  202 f09b: 30 a9        		br  update       ; Update cursor position
  203 f09d:              ;
  204 f09d:              ; Process a line feed: scroll the visible rows (at F300)
  205 f09d:              ;
  206 f09d: c0 f3 00     lf:		lbr scroll
  207 f0a0:              ;
  208 f0a0:              ; Process Back Space
  209 f0a0:              ;
  210 f0a0: 2c           bs:             dec rc         ; Register C is character pointer
  211 f0a1: f8 20        		ldi space       ; Clear postion with a space character
  212 f0a3: 5c           		str rc         ;
  213 f0a4: 30 a9        	        br  update     ; Update Cursor postion
  214 f0a6:              ;
  215 f0a6:              ; Process Normal Character
  216 f0a6:              ;
  217 f0a6: 8e           normal:         glo re         ; Register F.1 contains character
  218 f0a7: 5c           		str rc         ; Store at register C, Character pointer
  219 f0a8: 1c                           inc rc         ;
  220 f0a9:              ;
  221 f0a9:              ; Update Cursor position: R14/R15 = RC - 7000, through 7800 / 7801 (RF is saved above and restored at outdn)
  222 f0a9:              ;
  223 f0a9:              update:
  224 f0a9: f8 78        		ldi high crtca	; RF = 7800, the 6845's address register
  225 f0ab: bf           		phi rf
  226 f0ac: f8 00        		ldi low crtca
  227 f0ae: af           		plo rf
  228 f0af: f8 0e        		ldi cur_h      ; CRTC High cursor register
  229 f0b1: 5f           		str rf
  230 f0b2: 1f           		inc rf
  231 f0b3: 9c           		ghi rc         ; Get High portion of cursor postion
  232 f0b4: fa 07        		ani 07h        ; the 6845 address: 64 x row + column, 0-7FF
  233 f0b6: 5f           		str rf         ; cursor position high (7801)
  234 f0b7: 2f           		dec rf
  235 f0b8: f8 0f        		ldi cur_l      ; CRTC low cursor register
  236 f0ba: 5f           		str rf
  237 f0bb: 1f           		inc rf
  238 f0bc: 8c           		glo rc
  239 f0bd: 5f           		str rf         ; cursor positon low
  240 f0be:              ;
  241 f0be:              ; Store cursor position in memory
  242 f0be:              ;
  243 f0be: f8 77        		ldi high vmem_ch
