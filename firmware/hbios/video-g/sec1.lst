  914 f7cc:              e_monext:			; (build.py: must not pass F7CD)
  915 f7cc:              ;
  916 f7cc:              ; The IO panel demo (Ken, 2026-11-12): @F1C0 from the monitor. Over and over: read the toggles (INP 4), show them on
  917 f7cc:              ; the LEDs (OUT 4), and set Q to match INPUT (EF1: pressed = Q on). Reset ends it. The monitor's @ starts it with
  918 f7cc:              ; P = 0 and X = 0, so R0 is its program counter; INP and OUT need X on a byte of RAM, so R1 points at 00F0 (the
  919 f7cc:              ; monitor's workspace: nothing else runs meanwhile).
  920 f1c0:              		org 0f1c0h
  921 f1c0: f8 00        pdemo:		ldi 00h		; R1 = 00F0, a byte of RAM for INP and OUT
  922 f1c2: b1           		phi r1
  923 f1c3: f8 f0        		ldi 0f0h
  924 f1c5: a1           		plo r1
  925 f1c6: e1           		sex r1
  926 f1c7: 6c           ploop:		inp 4		; the toggles to M(R1) and D
  927 f1c8: 64           		out 4		; M(R1) to the LEDs; R1 + 1
  928 f1c9: 21           		dec r1
  929 f1ca: 34 cf        		b1 pqon		; INPUT pressed (EF1): Q on
  930 f1cc: 7a           		req
  931 f1cd: 30 c7        		br ploop
  932 f1cf: 7b           pqon:		seq
  933 f1d0: 30 c7        		br ploop
  934 f1d2:              e_pdemo:			; (build.py: must not pass F1E0)
  935 f1d2:              ;
  936 f1d2:              ; @F1E0 is v1.0.7's key-code display on the 6845-card ROMs. It is not in this ROM: here it restarts HBIOS.
  937 f1e0:              		org 0f1e0h
  938 f1e0: c0 f0 00     		lbr boot
  939 f1e3:              ;
  940 f1e3:              ; Q1 / Q0: the 1802's Q output on (SEQ, 7B) or off (REQ, 7A). Any number but 0 turns it on.
  941 f1e3: f8 00        monq:		ldi high 0004h	; read the number again from after the Q: f_hexin does not skip spaces
  942 f1e5: bf           		phi rf
  943 f1e6: f8 04        		ldi low 0004h
  944 f1e8: af           		plo rf
  945 f1e9: d4           		sep r4
  946 f1ea: ff 15        		dw f_ltrim
  947 f1ec: d4           		sep r4
  948 f1ed: ff 45        		dw f_hexin
  949 f1ef: 8d           		glo rd
  950 f1f0: c2 f1 f7     		lbz monq0
  951 f1f3: 7b           		seq
  952 f1f4: c0 f9 13     		lbr monprompt
  953 f1f7: 7a           monq0:		req
  954 f1f8: c0 f9 13     		lbr monprompt
  955 f1fb:              e_monq:				; (build.py: must not pass F200)
  956 f1fb:              ;
  957 f1fb:              ; The IO panel card's real-time clock (Ken, 2026-11-18; v1.0.8): a DS12885 on two ports, as the card's JP4 is set: OUT 6
  958 f1fb:              ; latches a register number, OUT 7 writes that register, INP 7 reads it. f_gettod (F815) and f_settod (F818) jump here
  959 f1fb:              ; (in v1.0.4-v1.0.7 they jump to the 's error return), and f_getdev's answer has bit 4 (an RTC) set. The calls are
  960 f1fb:              ; Mike Riley's, as his BIOS answers them for the ELF2000's DS1287 (orig_bios/bios.asm, e2k_gtod / e2k_stod): RF points
  961 f1fb:              ; at six bytes, month, day, year, hour, minute, second; the year is ELF/OS's (years since 1972), kept in the clock's
  962 f1fb:              ; year register as it is (28 years is a whole number of leap cycles, so the clock's leap years stay right). Binary,
  963 f1fb:              ; 24-hour mode, daylight saving off. DF = 0: done; f_gettod returns DF = 1 (D = 1) when the clock is not running in
  964 f1fb:              ; binary 24-hour mode: never set, or no clock at all (an INP of a port nobody drives reads FF, which is not 010 in DV).
  965 f1fb:              ; Called through SCRT (R4 / R5), so X = 2 and R2 is the stack: a byte goes out from M(R2) (STR R2, OUT n, DEC R2).
  966 f1fb:              ; Nothing but D, DF and RF changes.
  967 f1fb:              ;
  968 fc92:              		org 0fc92h
  969 fc92: d4           rtcget:		sep r4		; register A: is the oscillator running (DV = 010)?
  970 fc93: fc dd        		dw rtcrd
  971 fc95: 0a           		db 0ah
  972 fc96: fa 70        		ani 70h
  973 fc98: fb 20        		xri 20h
  974 fc9a: ca fc d8     		lbnz rtcbad
  975 fc9d: d4           		sep r4		; register B: binary (DM) and 24-hour?
  976 fc9e: fc dd        		dw rtcrd
  977 fca0: 0b           		db 0bh
  978 fca1: fa 06        		ani 06h
  979 fca3: fb 06        		xri 06h
  980 fca5: ca fc d8     		lbnz rtcbad
  981 fca8: d4           rtcuip:		sep r4		; wait while an update is in progress (UIP, register A bit 7): then
  982 fca9: fc dd        		dw rtcrd	; the registers stay put for 244 us at least
  983 fcab: 0a           		db 0ah
  984 fcac: fa 80        		ani 80h
  985 fcae: ca fc a8     		lbnz rtcuip
  986 fcb1: d4           		sep r4		; month
  987 fcb2: fc dd        		dw rtcrd
  988 fcb4: 08           		db 08h
  989 fcb5: 5f           		str rf
  990 fcb6: 1f           		inc rf
  991 fcb7: d4           		sep r4		; day
  992 fcb8: fc dd        		dw rtcrd
  993 fcba: 07           		db 07h
  994 fcbb: 5f           		str rf
  995 fcbc: 1f           		inc rf
  996 fcbd: d4           		sep r4		; year
  997 fcbe: fc dd        		dw rtcrd
  998 fcc0: 09           		db 09h
  999 fcc1: 5f           		str rf
 1000 fcc2: 1f           		inc rf
 1001 fcc3: d4           		sep r4		; hour
 1002 fcc4: fc dd        		dw rtcrd
 1003 fcc6: 04           		db 04h
 1004 fcc7: 5f           		str rf
 1005 fcc8: 1f           		inc rf
 1006 fcc9: d4           		sep r4		; minute
 1007 fcca: fc dd        		dw rtcrd
 1008 fccc: 02           		db 02h
 1009 fccd: 5f           		str rf
 1010 fcce: 1f           		inc rf
 1011 fccf: d4           		sep r4		; second
 1012 fcd0: fc dd        		dw rtcrd
 1013 fcd2: 00           		db 00h
 1014 fcd3: 5f           		str rf
 1015 fcd4: 1f           		inc rf
 1016 fcd5: fc 00        		adi 0		; DF = 0: done
 1017 fcd7: d5           		sep r5
 1018 fcd8: f8 01        rtcbad:		ldi 1		; DF = 1, D = 1: the clock is not set (or not there)
 1019 fcda: ff 00        		smi 0
 1020 fcdc: d5           		sep r5
 1021 fcdd:              ;
 1022 fcdd:              ; rtcrd: D = the clock's register named by the byte after the call. rtcwr: D into it.
 1023 fcdd: 46           rtcrd:		lda r6		; the register number
 1024 fcde: 52           		str r2
 1025 fcdf: 66           		out 6		; latch it (AS)
 1026 fce0: 22           		dec r2
 1027 fce1: 6f           		inp 7		; read the register (DS): to M(R2) and D
 1028 fce2: d5           		sep r5
 1029 fce3: 73           rtcwr:		stxd		; the value, kept below the free byte
 1030 fce4: 46           		lda r6		; the register number
 1031 fce5: 52           		str r2
 1032 fce6: 66           		out 6		; latch it (AS)
 1033 fce7: 22           		dec r2
 1034 fce8: 60           		irx		; R2 at the value
 1035 fce9: 67           		out 7		; write it (R/W)
 1036 fcea: 22           		dec r2		; R2 back where it was
 1037 fceb: d5           		sep r5
 1038 fcec:              e_rtc:				; (build.py: must not pass FD00)
 1039 fcec:              ;
 1040 fcec:              ; f_settod: start the oscillator (register A = 20h: DV = 010, no square wave), stop the count (SET) in binary 24-hour
 1041 fcec:              ; mode, write the six registers, then let it count (register B = 06h), as Mike's e2k_stod does but daylight saving off.
 1042 f7cd:              		org 0f7cdh
 1043 f7cd: f8 20        rtcset:		ldi 20h
