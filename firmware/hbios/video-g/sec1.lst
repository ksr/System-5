  284 f0d6:              ;
  285 f0d6: d5           outnochar:		sep r5         ; Return
  286 f0d7:              ; (brk sits here, in the free bytes after the driver, so that the rest of the H list fits after inchar)
  287 f0d7:              ;
  288 f0d7:              ; Check for a break character: DF = 1 if a key waits and it is ESC (a key that waits is read either way, as before)
  289 f0d7:              ;
  290 f0d7: e2           brk:		sex 2		; keep RF
  291 f0d8: 8f           		glo rf
  292 f0d9: 73           		stxd
  293 f0da: 9f           		ghi rf
  294 f0db: 73           		stxd
