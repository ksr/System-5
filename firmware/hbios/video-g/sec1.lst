  308 f0f0: fe           		shl            ; Shift left D
  309 f0f1: 30 f6        		br brkdone
  310 f0f3: f8 00        bnoclr:		ldi 00         ; Clear DF
  311 f0f5: fe           		shl            ;
  312 f0f6:              bno:
  313 f0f6: 60           brkdone:	irx		; RF back (IRX, LDXA, PHI, LDX, PLO leave DF alone)
  314 f0f7: 72           		ldxa
  315 f0f8: bf           		phi rf
  316 f0f9: f0           		ldx
  317 f0fa: af           		plo rf
