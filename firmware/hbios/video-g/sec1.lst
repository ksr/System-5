 1111 fc5d: 5e           		str re
 1112 fc5e: 1e           		inc re
 1113 fc5f: 4f           		lda rf
 1114 fc60: 5e           		str re
 1115 fc61: 1e           		inc re
 1116 fc62: 4f           		lda rf
 1117 fc63: 5e           		str re
 1118 fc64: 1e           		inc re
 1119 fc65: 4f           		lda rf
 1120 fc66: 5e           		str re
 1121 fc67: 1e           		inc re
 1122 fc68: 4f           		lda rf
 1123 fc69: 5e           		str re
 1124 fc6a: 1e           		inc re
 1125 fc6b: 4f           		lda rf
 1126 fc6c: 5e           		str re
 1127 fc6d: 1e           		inc re
 1128 fc6e: 4f           		lda rf
 1129 fc6f: 5e           		str re
 1130 fc70: 1e           		inc re
 1131 fc71: 4f           		lda rf
 1132 fc72: 5e           		str re
 1133 fc73: 1e           		inc re
 1134 fc74: 8f           		glo rf           ; source at xx40?
 1135 fc75: fb 40        		xri vis_end.0
 1136 fc77: 3a 50        		bnz sloop
 1137 fc79: 9f           		ghi rf           ; and past row 24 (RF = 7640)?
 1138 fc7a: fb 76        		xri high vis_end
 1139 fc7c: 3a 50        		bnz sloop
 1140 fc7e:              ; Blank row 24: Register E now points to its first character
 1141 fc7e: f8 20        erl:		ldi space        ; Space Character
 1142 fc80: 5e           		str re
 1143 fc81: 1e           		inc re
 1144 fc82: 8e           		glo re           ; up to 7640
 1145 fc83: fb 40        		xri vis_end.0
 1146 fc85: 3a 7e        		bnz erl          ; Continue erasing line
 1147 fc87: c0 f0 a9     		lbr update       ; and set the cursor (RC is unchanged)
 1148 fc8a:              e_scroll:			; (build.py: must not pass FC92)
