  318 f130: bf           		phi rf
  319 f131: f8 04        		ldi low vstat
  320 f133: af           		plo rf
  321 f134: 0f           		ldn rf		; KEY-READY?
  322 f135: f6           		shr
  323 f136: 3b 48        		bnf bno		; no key: DF = 0 (SHR left it 0)
  324 f138: f8 02        		ldi low kdata	; RF = 7802: the key
  325 f13a: af           		plo rf
  326 f13b: 0f           		ldn rf
  327 f13c: fb 1b        		xri 01bh       ; Check for ESC
  328 f13e: 3a 45                        bnz bnoclr     ; Not a break character
  329 f140: f8 ff        		ldi 0ffh       ; Set DF to 1
  330 f142: fe           		shl            ; Shift left D
  331 f143: 30 48        		br brkdone
  332 f145: f8 00        bnoclr:		ldi 00         ; Clear DF
  333 f147: fe           		shl            ;
  334 f148:              bno:
  335 f148: 60           brkdone:	irx		; RF back (IRX, LDXA, PHI, LDX, PLO leave DF alone)
  336 f149: 72           		ldxa
  337 f14a: bf           		phi rf
  338 f14b: f0           		ldx
  339 f14c: af           		plo rf
  340 f14d: d5           		sep r5         ; Return
