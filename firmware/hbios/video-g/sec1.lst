  274 f100:              		org 0f100h
  275 f100: e2           inchar:		sex 2		; keep RF on the stack (R2 = s on return, as on entry)
  276 f101: 8f           		glo rf
  277 f102: 73           		stxd
  278 f103: 9f           		ghi rf
  279 f104: 73           		stxd
