 1069 f7ef: fc e3        		dw rtcwr
 1070 f7f1: 02           		db 02h
 1071 f7f2: 4f           		lda rf		; second
 1072 f7f3: d4           		sep r4
 1073 f7f4: fc e3        		dw rtcwr
 1074 f7f6: 00           		db 00h
 1075 f7f7: f8 06        		ldi 06h		; count: binary, 24-hour, SET off
 1076 f7f9: d4           		sep r4
 1077 f7fa: fc e3        		dw rtcwr
 1078 f7fc: 0b           		db 0bh
 1079 f7fd: fc 00        		adi 0		; DF = 0
 1080 f7ff: d5           		sep r5
 1081 f800:              e_rtcset:			; (build.py: must not pass F800)
 1082 f800:              ;
 1083 f800:              ; Line feed: copy rows 1-24 to rows 0-23, twelve bytes a pass (1536 = 128 passes), then blank row 24.
 1084 f800:              ; RE = destination, RF = source; RC (the cursor) does not change. The source's low byte is 40h again only after
 1085 f800:              ; a whole 768 bytes (64 passes), at 7340 and at 7640, so the end test costs three instructions a pass.
 1086 f800:              ; At FC45, after the disk fix's code (FC31-FC44, put there by build.py).
 1087 f800:              ;
 1088 fc45:              		org 0fc45h
 1089 fc45: f8 70        scroll:		ldi high vmem    ; Register E = row 0
 1090 fc47: be           		phi re
 1091 fc48: f8 00        		ldi low vmem
 1092 fc4a: ae           		plo re
 1093 fc4b: 9e           		ghi re           ; Register F = row 1 (7040)
 1094 fc4c: bf           		phi rf
 1095 fc4d: f8 40        		ldi low vmem+64
 1096 fc4f: af           		plo rf
 1097 fc50:              sloop:
 1098 fc50: 4f           		lda rf		; twelve bytes of the row
 1099 fc51: 5e           		str re
 1100 fc52: 1e           		inc re
 1101 fc53: 4f           		lda rf
 1102 fc54: 5e           		str re
