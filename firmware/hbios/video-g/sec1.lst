  152 f067:              
  153 f067:              
  154 f067:              ;save registers
  155 f067: e2           cont1:        	sex 2
  156 f068: 8f           		glo rf
  157 f069: 73           		stxd
  158 f06a: 9f           		ghi rf
  159 f06b: 73           		stxd
  160 f06c: 8e           		glo re
  161 f06d: 73           		stxd
  162 f06e: 9e           		ghi re
  163 f06f: 73           		stxd
  164 f070: 8c           		glo rc
  165 f071: 73           		stxd
