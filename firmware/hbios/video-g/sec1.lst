  298 f0e1: af           		plo rf
  299 f0e2: 0f           		ldn rf		; KEY-READY?
  300 f0e3: f6           		shr
  301 f0e4: 3b f6        		bnf bno		; no key: DF = 0 (SHR left it 0)
  302 f0e6: f8 02        		ldi low kdata	; RF = 7802: the key
  303 f0e8: af           		plo rf
  304 f0e9: 0f           		ldn rf
