  281 f107: bf           		phi rf
  282 f108: f8 04        		ldi low vstat
  283 f10a: af           		plo rf
  284 f10b: 0f           inwait:		ldn rf		; Wait for an input character: KEY-READY (bit 0), polled, not EF3 (CPU Rev D has -EF
  285 f10c: f6           		shr		; on EF4)
  286 f10d: 3b 0b        		bnf inwait
  287 f10f: f8 02        		ldi low kdata	; RF = 7802: Read character (the read clears KEY-READY)
  288 f111: af           		plo rf
  289 f112: 0f           		ldn rf
  290 f113: 52           		str r2		; the character, in the free byte below the saved RF
  291 f114: fa 80        		ani 080h       ; VIDEO-G: F1-F12, arrows etc. send 80h and up: return them, but no echo
  292 f116: 3a 1e        		bnz innoecho
  293 f118: 02           		ldn r2         ; the character again
  294 f119: 22           		dec r2         ; Decrement (R2) Save inputed character across call
  295 f11a: d4           		sep r4         ; Output the character
  296 f11b: f2 03        		dw out         ;
  297 f11d: 12           		inc r2         ; Increment (R2) restore inputed character
  298 f11e: 60           innoecho:	irx		; RF back
  299 f11f: 72           		ldxa
  300 f120: bf           		phi rf
  301 f121: f0           		ldx
  302 f122: af           		plo rf
  303 f123: 22           		dec r2		; the character, two below R2 (nothing has written there since)
  304 f124: 22           		dec r2
  305 f125: 02           		ldn r2         ; Get the input Character
  306 f126: 12           		inc r2
  307 f127: 12           		inc r2
  308 f128: d5           		sep r5         ; Return
  309 f129:              ;
  310 f129:              ; Check for a break character: DF = 1 if a key waits and it is ESC (a key that waits is read either way, as before)
  311 f129:              ;
  312 f129: e2           brk:		sex 2		; keep RF
  313 f12a: 8f           		glo rf
  314 f12b: 73           		stxd
  315 f12c: 9f           		ghi rf
  316 f12d: 73           		stxd
