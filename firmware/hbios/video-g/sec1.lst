   53 0000:              
   54 ff54:             minimon:	equ     0ff54h
   55 0000:              
   56 7800:             crtca:		equ	07800h		; the 6845: address register (VIDEO-G, memory-mapped)
   57 7801:             crtcd:		equ	07801h		; the 6845: data register
   58 7802:             kdata:		equ	07802h		; the key (reading it clears KEY-READY)
   59 7804:             vstat:		equ	07804h		; status (read; bit 0 = KEY-READY) and control (write)
   60 000e:             cur_h:		equ     14		; Cursor postion high
   61 000f:             cur_l:		equ     15		; Cursor postion low
   62 0000:              
   63 7000:             vmem:		equ	07000h		; Start of video memory
   64 7800:             vmem_end:	equ     07800h		; End of video memory
   65 77fe:             vmem_ch:	equ	vmem_end-2
   66 77ff:             vmem_cl:	equ     vmem_end-1
   67 0020:             space:		equ	020h		; Ascii Space
   68 0019:             rows:		equ	25		; VIDEO-G NTSC: 64 x 25
   69 7600:             line24:		equ     vmem+(64*24)	; the bottom row
   70 7640:             vis_end:	equ	vmem+(64*25)	; end of the visible text (7640)
   71 0000:              
   72 ff00:             JUMPTBL:	equ	0ff00h
   73 f700:             basic_start:	equ	0f700h
   74 feff:             basic_end:	equ	0feffh
   75 0100:             basic_dest:	equ	00100h
   76 f500:             basmon:		equ	0f500h
