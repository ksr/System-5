    1 0000:              ;
    2 0000:              ; HBIOS for VIDEO-G 1.0 (System-5), made 2026-11-01 from HBIOS v1.0.4 (firmware/hbios/v1.0.4/sec1.asm, unchanged).
    3 0000:              ; Changes, all for the VIDEO-G TEXT board (hardware/video-g/DESIGN.md sections 2, 3 and 8):
    4 0000:              ;   - the 6845 is on ports: OUT 5 = address register, OUT 6 = data (7800/7801 is now the graphics window)
    5 0000:              ;   - the 64 x 25 NTSC table (R0-R9 = 94,64,76,8,31,6,25,28,0,7; 8 x 8 cells), cursor rows 0-7
    6 0000:              ;   - the bottom row is row 24 (7600); the cursor is kept in 77FE/77FF as before (not displayed at 25 rows)
    7 0000:              ;   - OUT 4 = 00 at start: text on, graphics, XOR and mouse off, page 0
    8 0000:              ;   - a line feed scrolls only the 24 visible rows (an unrolled copy, 1536 bytes) and blanks row 24:
    9 0000:              ;     about 45 ms at 1.76 MHz, against 168 ms for the v1.0.4 copy of all of 7040-77FF
   10 0000:              ;   - the cursor address sent to R14/R15 is the 6845 address (RC - 7000), not the high byte of RC AND 3F
   11 0000:              ;   - a key of 80h or more (the VIDEO-G keyboard: F1-F12 80-8B, Home Up PgUp Left 5 Right End Down PgDn Ins Del
   12 0000:              ;     90-9A, with Shift C0-DA) is returned by inchar but not echoed (outchar strips bit 7: it would print junk)
   13 0000:              ; Everything else (the keyboard on INP 1 / EF3, break, the jump table at F200, the Riley code) is as in v1.0.4.
   14 0000:              ;
   15 0000:              ; Define BIOS to generate code for use with ELFOS BIOS
   16 0000:              ;
   17 0000:              
   18 0000:              
   19 0000:              
   20 0000:              ;
   21 0000:              ; Define 6845VIDEOLOWER when video card (REV B and beyond) supports lower
   22 0000:              ; case characters and there is no need to force characters to upper case
   23 0000:              ;
   24 0000:              
   25 0000:              
   26 0000:              
   27 0000:              ;
   28 0000:              ; Define BASIC if the is for use with Tiny basic and not for ELFOS
   29 0000:              ;
   30 0000:              
   31 0000:              ;
   32 0000:              ; minimon is entry point in ELFOS  to jump to once bios has booted
   33 0000:              ;
   34 0000:              
   35 ff54:             minimon:	equ     0ff54h
   36 0000:              
   37 000e:             cur_h:		equ     14		; Cursor postion high
   38 000f:             cur_l:		equ     15		; Cursor postion low
   39 0000:              
   40 7000:             vmem:		equ	07000h		; Start of video memory
   41 7800:             vmem_end:	equ     07800h		; End of video memory
   42 77fe:             vmem_ch:	equ	vmem_end-2
   43 77ff:             vmem_cl:	equ     vmem_end-1
   44 0020:             space:		equ	020h		; Ascii Space
   45 0019:             rows:		equ	25		; VIDEO-G NTSC: 64 x 25
   46 7600:             line24:		equ     vmem+(64*24)	; the bottom row
   47 7640:             vis_end:	equ	vmem+(64*25)	; end of the visible text (7640)
   48 0000:              
   49 ff00:             JUMPTBL:	equ	0ff00h
   50 f700:             basic_start:	equ	0f700h
   51 feff:             basic_end:	equ	0feffh
   52 0100:             basic_dest:	equ	00100h
   53 f500:             basmon:		equ	0f500h
   54 0000:              
   55 f000:              		org 0f000h
   56 f000: f8 f0        boot:		ldi high boot	;Trigger Boot rom remap
   57 f002: b0           		phi r0		;
   58 f003: e0           		sex r0		; X = P: OUT with the byte that follows
   59 f004: 64           		out 4		; VIDEO-G control register (OUT 4) = 00: text on, graphics off
   60 f005: 00           		db 00h
   61 f006: f8 f0        		ldi high vtable ; Register D set to vtable (CRTC register, value pairs)
   62 f008: bd           		phi rd          ;
   63 f009: f8 34        		ldi low vtable  ;
   64 f00b: ad           		plo rd          ;
   65 f00c: ed           		sex rd		; X = RD: OUT sends M(RD) and steps RD
   66 f00d:              ;
   67 f00d:              ; Load Video Paramters into CRTC
   68 f00d:              ;
   69 f00d: 65           vload:          out 5           ; register number to the 6845 address register (OUT 5)
   70 f00e: 66           	        out 6           ; its value to the 6845 data register (OUT 6)
   71 f00f: 8d           	        glo rd          ; end of the table?
   72 f010: fb 54        	        xri vtable_end.0
   73 f012: 3a 0d        	        bnz  vload      ; If not load next CRTC Video paramter
   74 f014: e0           		sex r0		; (X back to the program counter, as after reset)
   75 f015:              ;
   76 f015:              ; Clear Video memory (with space charachter)
   77 f015:              ;
   78 f015:              
   79 f015: f8 70        		ldi high vmem   ; Register F set to start of Video memory
   80 f017: bf           		phi rf          ;
   81 f018: f8 00        		ldi low vmem    ;
   82 f01a: af           		plo rf          ;
   83 f01b: f8 20        clear:          ldi space        ; Load D  space character
   84 f01d: 5f           		str rf          ; Sstore in Video memory
   85 f01e: 1f           		inc rf          ; Increment Register F to next video memory location
   86 f01f: 9f           		ghi rf          ; Check if past end of video memory
   87 f020: fb 78        		xri high vmem_end ; Logical XOR D with value
   88 f022: 3a 1b        		bnz clear       ; Short branch on D!=0
   89 f024:              ;
   90 f024:              ; Store cursor position in memory
   91 f024:              ;
   92 f024: f8 77        		ldi high vmem_ch
   93 f026: bf           		phi rf
   94 f027: f8 fe        		ldi low vmem_ch
   95 f029: af           		plo rf
   96 f02a: f8 76        		ldi high line24
   97 f02c: 5f           		str rf
   98 f02d: 1f           		inc rf
   99 f02e: f8 00        		ldi low line24
  100 f030: 5f           		str rf
  101 f031:              ;
  102 f031:              ; Initialization complete jump to real start
  103 f031:              ;
  104 f031: c0 f2 09     		lbr  cold_entry      ; Long branch
  105 f034:              ;
  106 f034:              ; Video Paramters: (register, value) pairs, 64 x 25 NTSC (hardware/video-g/DESIGN.md section 2)
  107 f034:              ;
  108 f034: 00 5e        vtable:		 db 0,94  ; R0 total number of horiz chars
  109 f036: 01 40        		 db 1,64  ; R1 number of horiz chars displayed
  110 f038: 02 4c        		 db 2,76  ; R2 Horiz sync position (chars)
  111 f03a: 03 08        		 db 3,8   ; R3 VSYNC/HSYNC Widths
  112 f03c: 04 1f        		 db 4,31  ; R4 Vert Total (chars)
  113 f03e: 05 06        		 db 5,6   ; R5 Vert total Adjust (scan lines)
  114 f040: 06 19        		 db 6,25  ; R6 Vert displayed (chars)
  115 f042: 07 1c        		 db 7,28  ; R7 Vert Sync position (chars)
  116 f044: 08 00        		 db 8,0   ; R8 mode contro;
  117 f046: 09 07        		 db 9,7   ; R9 scan lines/char (8)
  118 f048: 0a 40        		 db 10,64 ; R10 cursor start (scan line/char) + blink rate
  119 f04a: 0b 07        		 db 11,7  ; R11 cursor end (scan line/char)
  120 f04c: 0c 00        		 db 12,0  ; R12 display addr start high
  121 f04e: 0d 00        		 db 13,0  ; R13 display addr start low
  122 f050: 0e 06        		 db 14,6  ; R14 Cursor position high (row 24)
  123 f052: 0f 00        		 db 15,0  ; R15 Cursor positon low
  124 f054:              vtable_end:
  125 f054:              ;
  126 f054:              ; Input/Output routines
  127 f054:              ;
  128 f054:              ; output a character
  129 f054:              ; Character to output in D
  130 f054:              ;
  131 f054: fa 7f        outchar: 	ani 07fh         ; Strip off high bit
  132 f056: ae           		plo re           ; Store Character to output in Register e.0
  133 f057: fb 7f        		xri 07fh         ; Check if character is is 07Fh (??? Why)
  134 f059: 32 ca        		bz  outnochar    ; If yes done
  135 f05b: 8e           		glo re
  136 f05c:              
  137 f05c:              
  138 f05c:              
  139 f05c:              ;save registers
  140 f05c: e2           cont1:        	sex 2
  141 f05d: 8f           		glo rf
  142 f05e: 73           		stxd
  143 f05f: 9f           		ghi rf
  144 f060: 73           		stxd
  145 f061: 8e           		glo re
  146 f062: 73           		stxd
  147 f063: 9e           		ghi re
  148 f064: 73           		stxd
  149 f065: 8c           		glo rc
  150 f066: 73           		stxd
  151 f067: 9c           		ghi rc
  152 f068: 73           		stxd
  153 f069:              ;
  154 f069:              ; Get character position in RC
  155 f069:              ;
  156 f069: f8 77        		ldi high vmem_ch ; Register F points to CRTC Address register
  157 f06b: bf           		phi rf         ;
  158 f06c: f8 fe        		ldi low vmem_ch ;
  159 f06e: af           		plo rf         ;
  160 f06f: 0f           		ldn rf	       ; Get cursor position high
  161 f070: bc           		phi rc         ; Store in RC.1
  162 f071: 1f           		inc rf
  163 f072: 0f           		ldn rf	       ; Get cursor position low
  164 f073: ac           		plo rc	       ; Store in RC.0
  165 f074:              
  166 f074:              
  167 f074: 8e           	        glo re           ; Check for a control Character below 020h
  168 f075: fa e0                        ani 0e0h         ;
  169 f077: 3a 9b        		bnz  normal      ; Normal character
  170 f079: 8e           		glo re           ; Check for carriage return 0dh
  171 f07a: fb 0d        		xri 0dh          ;
  172 f07c: 32 8a        		bz  cr           ; Process carriage return
  173 f07e: 8e           		glo re           ; Check for line feed 0ah
  174 f07f: fb 0a        		xri 0ah          ;
  175 f081: 32 92        		bz  lf           ; Process line feed
  176 f083: 8e           		glo re           ; Check for backspace
  177 f084: fb 08        		xri 08h          ;
  178 f086: 32 95        		bz  bs           ; process backspace
  179 f088: 30 bd        		br  outdn
  180 f08a:              ;
  181 f08a:              ; Process a carriage return
  182 f08a:              ;
  183 f08a: f8 76        cr:		ldi high line24  ; Set Register C to start of the bottom row
  184 f08c: bc           		phi rc         	 ;
  185 f08d: f8 00        		ldi low line24   ;
  186 f08f: ac           		plo rc           ;
  187 f090: 30 9e        		br  update       ; Update cursor position
  188 f092:              ;
  189 f092:              ; Process a line feed: scroll the visible rows (at F300)
  190 f092:              ;
  191 f092: c0 f3 00     lf:		lbr scroll
  192 f095:              ;
  193 f095:              ; Process Back Space
  194 f095:              ;
  195 f095: 2c           bs:             dec rc         ; Register C is character pointer
  196 f096: f8 20        		ldi space       ; Clear postion with a space character
  197 f098: 5c           		str rc         ;
  198 f099: 30 9e        	        br  update     ; Update Cursor postion
  199 f09b:              ;
  200 f09b:              ; Process Normal Character
  201 f09b:              ;
  202 f09b: 8e           normal:         glo re         ; Register F.1 contains character
  203 f09c: 5c           		str rc         ; Store at register C, Character pointer
  204 f09d: 1c                           inc rc         ;
  205 f09e:              ;
  206 f09e:              ; Update Cursor position: R14/R15 = RC - 7000 through OUT 5 / OUT 6 (X = 2)
  207 f09e:              ;
  208 f09e:              update:
  209 f09e: f8 0e        		ldi cur_h      ; CRTC High cursor register
  210 f0a0: 52           		str r2         ; (the free byte below the stack)
  211 f0a1: 65           		out 5          ; set CRTC Address register (R2 + 1)
  212 f0a2: 22           		dec r2
  213 f0a3: 9c           		ghi rc         ; Get High portion of cursor postion
  214 f0a4: fa 07        		ani 07h        ; the 6845 address: 64 x row + column, 0-7FF
  215 f0a6: 52           		str r2
  216 f0a7: 66           		out 6          ; cursor position high
  217 f0a8: 22           		dec r2
  218 f0a9: f8 0f        		ldi cur_l      ; CRTC low cursor register
  219 f0ab: 52           		str r2
  220 f0ac: 65           		out 5          ; set CRTC Address register
  221 f0ad: 22           		dec r2
  222 f0ae: 8c           		glo rc
  223 f0af: 52           		str r2
  224 f0b0: 66           		out 6          ; cursor positon low
  225 f0b1: 22           		dec r2
  226 f0b2:              ;
  227 f0b2:              ; Store cursor position in memory
  228 f0b2:              ;
  229 f0b2: f8 77        		ldi high vmem_ch
  230 f0b4: bf           		phi rf
  231 f0b5: f8 fe        		ldi low vmem_ch
  232 f0b7: af           		plo rf
  233 f0b8: 9c           		ghi rc
  234 f0b9: 5f           		str rf
  235 f0ba: 1f           		inc rf
  236 f0bb: 8c           		glo rc
  237 f0bc: 5f           		str rf
  238 f0bd:              ;
  239 f0bd:              ;restore registers
  240 f0bd:              ;
  241 f0bd:              outdn:
  242 f0bd: 60           		irx
  243 f0be: 72           		ldxa
  244 f0bf: bc           		phi rc
  245 f0c0: 72           		ldxa
  246 f0c1: ac           		plo rc
  247 f0c2: 72           		ldxa
  248 f0c3: be           		phi re
  249 f0c4: 72           		ldxa
  250 f0c5: ae           		plo re
  251 f0c6: 72           		ldxa
  252 f0c7: bf           		phi rf
  253 f0c8: f0           		ldx
  254 f0c9: af           		plo rf
