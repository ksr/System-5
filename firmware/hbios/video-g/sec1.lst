  260 f100:              		org 0f100h
  261 f100: 3e 00        inchar:         bn3  inchar    ; Wait for an input character
  262 f102: e2                   	sex 2
  263 f103: 69           		inp 1          ; Read character
  264 f104: fa 80        		ani 080h       ; VIDEO-G: F1-F12, arrows etc. send 80h and up: return them, but no echo
  265 f106: 3a 0e        		bnz innoecho
  266 f108: 02           		ldn r2         ; the character again
  267 f109: 22           		dec r2         ; Decrement (R2) Save inputed character across call
  268 f10a: d4           		sep r4         ; Output the character
  269 f10b: f2 03        		dw out         ;
  270 f10d: 12           		inc r2         ; Increment (R2) restore inputed character
  271 f10e: 02           innoecho:	ldn r2         ; Get the input Character
  272 f10f: d5           		sep r5         ; Return
  273 f110:              ;
  274 f110:              ; Check for a break character
  275 f110:              ;
  276 f110: 36 17        brk:		b3  brkchk     ; Character is available
  277 f112: f8 00        bno:		ldi 00         ; Clear DF
  278 f114: fe           		shl            ;
  279 f115: 30 20        	        br brkdone       ; Return
  280 f117:              ;
  281 f117:              ;
  282 f117:              ;
  283 f117:              brkchk:
  284 f117: e2                   	sex 2
  285 f118: 69           		inp 1          ; Input to (R(X)) and D, N=001
  286 f119: fb 1b        		xri 01bh       ; Check for ESC
  287 f11b: 3a 12                        bnz bno        ; Not a break character
  288 f11d: f8 ff        		ldi 0ffh       ; Set DF to 1
  289 f11f: fe           		shl            ; Shift left D
  290 f120: d5           brkdone:	sep r5         ; Return
