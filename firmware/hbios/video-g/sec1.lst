  156 f05f:              ; Input/Output routines
  157 f05f:              ;
  158 f05f:              ; output a character
  159 f05f:              ; Character to output in D
  160 f05f:              ;
  161 f05f: fa 7f        outchar: 	ani 07fh         ; Strip off high bit
  162 f061: ae           		plo re           ; Store Character to output in Register e.0
  163 f062: fb 7f        		xri 07fh         ; Check if character is is 07Fh (??? Why)
  164 f064: 32 d6        		bz  outnochar    ; If yes done
  165 f066: 8e           		glo re
