    1 0000:              ; cls for Elf/OS v5 on System-5: clears the screen of the 6845 card (16 lines) or of VIDEO-G (25 lines).
    2 0000:              ; Author: Claude (Anthropic) for Ken Rother's System-5 project, 2026-11-14; both cards 2026-11-20
    3 0000:              ;
    4 0000:              ; Mike Riley's cls types ESC [ H ESC [ 2 J, the codes that clear an ANSI terminal. HBIOS's screen is not one: it
    5 0000:              ; showed "[H[2J" and cleared nothing. This program writes spaces over the screen itself.
    6 0000:              ;
    7 0000:              ; HBIOS types on the bottom line of the screen and scrolls the rest up, so there is no "home". The cursor is left
    8 0000:              ; where it is, at the start of the bottom line, and the next text appears there.
    9 0000:              ; The screen starts at 7000, 64 characters a line. How many lines it has depends on the video card: 16 on the 6845
   10 0000:              ; card (7000-73FF), 25 on VIDEO-G (7000-763F). HBIOS keeps its cursor position, an address in that RAM, in the last
   11 0000:              ; two bytes of the video RAM (77FE high, 77FF low), and when cls runs the cursor is on the bottom line: 73C0 on the
   12 0000:              ; 6845 card, 7600 on VIDEO-G. So this program clears from 7000 to the end of the line the cursor is on, and is the
   13 0000:              ; same program for both cards (until 2026-11-20 it cleared 7000-73FF, which left VIDEO-G's lines 16-24 as they were).
   14 0000:              ; If those two bytes do not hold an address a cursor can have (below 7000, or in the last line, 77C0-77FF, where
   15 0000:              ; the two bytes themselves are), it clears the 6845 card's 16 lines. The two bytes are never touched.
   16 0000:              ;
   17 0000:              ; Build: python3 software/elfos-v5/build.py  (tools/asm1802.py; it writes cls, the Elf/OS program, and cls.lst)
   18 0000:              
   19 7000:             screen:     equ     07000h          ; the video RAM: 64 characters a line
   20 77fe:             cursor:     equ     077feh          ; HBIOS's cursor position: the high byte, then the low byte
   21 7400:             scrend16:   equ     07400h          ; one past the 6845 card's 16 lines
   22 0000:              
   23 2000:                          org     2000h
   24 2000: 30 1b                    br      start
   25 2002:              ; What `ver /bin/cls` shows, laid out as in Mike Riley's programs: the month (with C0h added, as his have it), the
   26 2002:              ; day, the year, the hour, minute and second, a build number, and a text.
   27 2002: cb 14                    db      0c0h + 11, 20
   28 2004: 07 ea                    dw      2026
   29 2006: 0c 00 00                 db      12, 0, 0
   30 2009: 00 02                    dw      2
   31 200b: 53 79 73 74              db      'System-5 screen', 0
      200f: 65 6d 2d 35 
      2013: 20 73 63 72 
      2017: 65 65 6e 00 
   32 201b:              
   33 201b: f8 77        start:      ldi     high cursor     ; RF at HBIOS's cursor position
   34 201d: bf                       phi     rf
   35 201e: f8 fe                    ldi     low cursor
   36 2020: af                       plo     rf
   37 2021: 4f                       lda     rf              ; RE = the last character of the cursor's line ...
   38 2022: be                       phi     re
   39 2023: 0f                       ldn     rf
   40 2024: f9 3f                    ori     3fh
   41 2026: ae                       plo     re
   42 2027: 1e                       inc     re              ; ... and one past it: 7400 on the 6845 card, 7640 on VIDEO-G
   43 2028: 9e                       ghi     re              ; an address in 7040-77C0?
   44 2029: ff 70                    smi     high screen
   45 202b: 3b 31                    bnf     lines16         ; below 7000: not a cursor
   46 202d: ff 08                    smi     08h
   47 202f: 3b 37                    bnf     found           ; 70xx-77xx: clear up to there
   48 2031: f8 74        lines16:    ldi     high scrend16   ; anything else: the 6845 card's 16 lines
   49 2033: be                       phi     re
   50 2034: f8 00                    ldi     low scrend16
   51 2036: ae                       plo     re
   52 2037: f8 70        found:      ldi     high screen     ; RF = the first character of the screen
   53 2039: bf                       phi     rf
   54 203a: f8 00                    ldi     low screen
   55 203c: af                       plo     rf
   56 203d: f8 20        clear:      ldi     ' '
   57 203f: 5f                       str     rf
   58 2040: 1f                       inc     rf
   59 2041: 8f                       glo     rf              ; until RF is at RE (the low byte is 00 or 40h only at the end of a line)
   60 2042: 52                       str     r2
   61 2043: 8e                       glo     re
   62 2044: f3                       xor
   63 2045: 3a 3d                    bnz     clear
   64 2047: 9f                       ghi     rf
   65 2048: 52                       str     r2
   66 2049: 9e                       ghi     re
   67 204a: f3                       xor
   68 204b: 3a 3d                    bnz     clear
   69 204d: f8 00                    ldi     0               ; the program's return value: no error
   70 204f: d5                       sep     r5              ; back to Elf/OS

203d: CLEAR
77fe: CURSOR
2037: FOUND
2031: LINES16
7000: SCREEN
7400: SCREND16
201b: START
